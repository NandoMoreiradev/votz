# Database
DATABASE_URL=postgresql://votz:votz@localhost:5432/votz

# Redis
REDIS_URL=redis://localhost:6379

# JWT — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GERE_UM_SECRET_FORTE_64_BYTES_HEX
# Obsoleto (opcional): refresh tokens agora são opacos (SHA-256) armazenados na tabela refresh_tokens
# JWT_REFRESH_SECRET=GERE_UM_SECRET_FORTE_64_BYTES_HEX_DIFERENTE
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CPF_ENCRYPTION_KEY=GERE_32_BYTES_HEX_PARA_AES256

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@gmail.com
SMTP_PASS=sua_app_password
SMTP_FROM=Votz <noreply@votz.app>

# OAuth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Cloudflare R2
CLOUDFLARE_R2_BUCKET=votz-media
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_ENDPOINT=
# URL pública do bucket (domínio próprio ou pub-XXX.r2.dev). Sem ela, as URLs de mídia dos relatos não abrem.
CLOUDFLARE_R2_PUBLIC_URL=
# Envio direto de vídeo e PDF de relato (o app envia ao bucket por endereço assinado, sem passar pela API).
# Em produção o bucket PRECISA de regra de CORS liberando PUT e o cabeçalho Content-Type para o domínio do web.
# Sem ela o navegador falha e o app volta sozinho para o envio pela API. Use false para desligar de vez.
DIRECT_UPLOAD_ENABLED=true
# YouTube Data API v3 (debates ao vivo). Chave só com essa API, restrita por API no Google Cloud.
# Só lê dados públicos (vídeo, canal). Sem ela, o debate com YouTube avisa que ainda não está ligado.
YOUTUBE_API_KEY=
# Cota de mídia das conversas por pessoa, em MB (padrão 2048). Passou disso, o envio é recusado até a pessoa apagar arquivos ou ganhar mais espaço.
CHAT_MEDIA_QUOTA_MB=2048
# Domínios externos permitidos para avatarUrl oficial de políticos importados (separados por vírgula)
ALLOWED_EXTERNAL_IMAGE_HOSTS=www.camara.leg.br,camara.leg.br,www.senado.leg.br

# Mapbox
MAPBOX_TOKEN=

# Google AI (Gemini embeddings — text-embedding-004)
GOOGLE_AI_API_KEY=

# App
API_PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Sentry (opcional no dev)
SENTRY_DSN=

# Busca integrada de GIFs nos comentários (opcional — upload direto .gif funciona sem chave)
KLIPY_API_KEY=
GIPHY_API_KEY=

# Security requirements (enforced in production boot via env.validation.ts):
# - JWT_SECRET: >= 32 characters (`openssl rand -hex 32`)
# - JWT_REFRESH_SECRET: >= 32 characters and distinct from JWT_SECRET (`openssl rand -hex 32`)
# - CPF_ENCRYPTION_KEY: exact 64 hex chars / 32 bytes (`openssl rand -hex 32`)
## Conversation metadata pilot. Keep disabled until explicitly testing this stage.
CONVERSATIONS_ENABLED=false

# Encrypted text pilot; requires private Synapse and client validation.
CHAT_TEXT_ENABLED=false
CHAT_MATRIX_URL=http://127.0.0.1:8008
CHAT_MATRIX_SERVER_NAME=chat.votz.local
CHAT_MATRIX_JWT_SECRET=
CHAT_MATRIX_REGISTRATION_SECRET=
CHAT_TOKEN_ENCRYPTION_KEY=
CHAT_PUSH_ENABLED=false

# Anúncios: saldo pré-pago. "test" = recarga de teste sem serviço externo (padrão fora de produção);
# "live" = Asaas (Pix e boleto) e Stripe (cartão), ainda não ligados (padrão em produção).
ADS_BILLING_MODE=test

# Revisão de anúncios por IA (Gemini). Usa GOOGLE_AI_API_KEY. Sem a chave, tudo vai direto para a fila humana.
# A IA sempre anota o anúncio para o moderador. Só aprova sozinha se ADS_AI_AUTO_APPROVE=true (decisão do dono).
ADS_AI_MODEL=gemini-2.5-flash
ADS_AI_AUTO_APPROVE=false

# Anúncios: endereço do botão do anúncio (leva ao anunciante com o votz_click_id). Sem esta variável: em
# desenvolvimento usa a API local (http://localhost:PORT/api/v1/ads/c) e em produção usa APP_URL + "/c".
# Em produção o site (Caddy) repassa /c/* para a API (variável API_ORIGIN do site). Exemplo: https://votz.app/c
# AD_CLICK_URL_BASE=
