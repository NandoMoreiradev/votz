{
  "name": "@votz/ads-server",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor de anúncios do Votz: só a entrega (GET /ads/next) e os eventos (POST /ads/events), separados da API para escalar e falhar sozinhos.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/ads-server/src/main.js",
    "start:prod": "node dist/ads-server/src/main.js",
    "start:dev": "dotenv -e ../../.env -- ts-node --transpile-only --project tsconfig.json src/main.ts",
    "test": "jest"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "testEnvironment": "node"
  }
}
