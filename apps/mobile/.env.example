# USB: adb reverse tcp:3000 tcp:3000
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000/api/v1
# Production / preview require a real HTTPS API URL.
APP_VARIANT=development
# Optional custom MapLibre style/provider. Default: OpenFreeMap Positron.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
