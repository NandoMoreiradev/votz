{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "APP_VARIANT": "development", "EXPO_PUBLIC_API_URL": "http://127.0.0.1:3000/api/v1" }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview": { "distribution": "internal", "channel": "preview", "env": { "APP_VARIANT": "preview" } },
    "production": { "autoIncrement": true, "channel": "production", "env": { "APP_VARIANT": "production" } }
  }
}
