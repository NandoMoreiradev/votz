{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "APP_VARIANT": "development", "EXPO_PUBLIC_API_URL": "http://127.0.0.1:3000/api/v1" }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "preview", "EXPO_PUBLIC_API_URL": "https://api-production-a1dec526.up.railway.app/api/v1" }
    },
    "cloud-test": {
      "extends": "preview",
      "channel": "cloud-test",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "preview", "EXPO_PUBLIC_API_URL": "https://votz-api-742542852298.us-central1.run.app/api/v1" }
    },
    "production": { "autoIncrement": true, "channel": "production", "env": { "APP_VARIANT": "production" } }
  }
}
