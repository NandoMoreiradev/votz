{
  "name": "@votz/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/log-box": "~58.0.15",
    "@expo/metro-runtime": "~58.0.17",
    "@maplibre/maplibre-react-native": "^11.5.1",
    "@tanstack/react-query": "^5.108.0",
    "@votz/chat-core": "file:../../packages/chat-core",
    "@votz/shared-types": "file:../../packages/shared-types",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "lucide-react-native": "^1.74.0",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-matrix-crypto": "0.8.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "socket.io-client": "4.8.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "expo start --dev-client --localhost",
    "android": "expo run:android --device",
    "ios": "expo run:ios --device",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "check": "expo install --check",
    "android:doctor": "node scripts/android-usb.mjs",
    "android:usb": "node scripts/android-usb.mjs --connect",
    "export:android": "expo export --platform android --max-workers 2",
    "export:ios": "expo export --platform ios --max-workers 2"
  },
  "overrides": {
    "react-native-matrix-crypto": {
      "react-native": "$react-native"
    }
  },
  "private": true
}
