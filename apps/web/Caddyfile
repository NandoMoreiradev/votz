{
	admin off
	auto_https off
}

# O Railway termina o HTTPS e manda para a porta definida em PORT.
:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	import /etc/caddy/auth.caddy

	# Origens externas que o navegador pode chamar. Ajustadas por variável no Railway.
	# API_ORIGIN: https://<dominio-da-api>   STORAGE_ORIGIN: https://<dominio-do-bucket>
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; media-src 'self' blob: https:; connect-src 'self' {$API_ORIGIN:https://api.invalid} {$API_WS_ORIGIN:wss://api.invalid} {$STORAGE_ORIGIN:https://storage.invalid} https://api.maptiler.com https://*.livekit.cloud wss://*.livekit.cloud https://brasilapi.com.br; worker-src 'self' blob:; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(self), geolocation=(self)"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Teste fechado: pede para os buscadores não indexarem.
		X-Robots-Tag "noindex, nofollow"
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html not path /assets/*
	header @html Cache-Control "no-cache"

	# Clique no anúncio (`/c/<id>`): quem responde é a API, que leva à página do anunciante.
	# Sem API_ORIGIN, a rota responde 404 e o site segue funcionando.
	@adclick path /c/*
	handle @adclick {
		rewrite * /api/v1/ads{uri}
		reverse_proxy {$API_ORIGIN:https://api.invalid}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
