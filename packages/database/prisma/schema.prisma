generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ==================== ENUMS ====================

enum UserType {
  CITIZEN
  ENTITY
  POLITICIAN
  COMPANY
  PRESS
  NGO
  RESEARCHER
  MODERATOR
  ADMIN
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  DISPUTED
  ARCHIVED
}

enum EventType {
  CREATED
  RESPONDED
  STATUS_CHANGED
  UPDATE
  DISPUTED
  RESOLVED
  ARCHIVED
}

enum Category {
  HEALTH
  MOBILITY
  SAFETY
  EDUCATION
  SANITATION
  HOUSING
  ENVIRONMENT
  INFRASTRUCTURE
  URBAN_SERVICES
  CORRUPTION
  ACCESSIBILITY
  SOCIAL_WELFARE
  OTHER
}

enum EntityType {
  CITY_HALL
  HOSPITAL
  CONCESSIONAIRE
  AUTARCHY
  SECRETARIAT
  OTHER
}

enum CompanySector {
  TELECOM
  SUPPLEMENTAL_HEALTH
  FINANCIAL
  ENERGY
  TRANSPORTATION
  RETAIL
  FOOD
  CONDOMINIUM
  OTHER
}

enum CompanySize {
  MEI
  SMALL
  MEDIUM
  LARGE
}

enum CompanyPlan {
  STARTER
  BUSINESS
  ENTERPRISE
  WHITE_LABEL
}

enum EntityPlan {
  BASICO
  GESTAO
  INTEGRACAO
}

enum PoliticianPlan {
  BASICO
  MANDATO
  MANDATO_PRO
}

enum PoliticianStatus {
  ATIVO
  ENCERRADO
  AFASTADO
}

enum RecipientType {
  ENTITY
  COMPANY
  BRANCH
  POLITICIAN
}

enum VoteType {
  SUPPORT
  ME_TOO
}

enum OrgType {
  ENTITY
  POLITICIAN
  COMPANY
}

enum OrgPermission {
  RESPOND_REPORTS
  MANAGE_MEMBERS
  MANAGE_PROFILE
  VIEW_ANALYTICS
  EXPORT_DATA
  MANAGE_BRANCHES
  MANAGE_BILLING
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum RegistrationRequestType {
  ENTITY
  POLITICIAN
  COMPANY
}

enum RegistrationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  NEW_COMMENT
  STATUS_CHANGED
  SURTO_DETECTED
  ALERT_RULE_MATCHED
  WEEKLY_DIGEST
}

enum ApiKeyTier {
  FREE
  PAID
}

enum FollowerActorType {
  POLITICIAN
  ENTITY
}

enum PropostaStatus {
  DRAFT
  PRESENTED
  IN_VOTE
  APPROVED
  REJECTED
  ARCHIVED
}

enum PropostaEventType {
  CREATED
  STATUS_CHANGED
  UPDATED
}

enum CommentMediaType {
  TEXT
  AUDIO
  VIDEO
}

enum DebateStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum ParticipantRole {
  MODERATOR
  DEBATER
}

enum InviteStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum ReactionType {
  APPLAUSE
  FIRE
  POSITIVE
  QUESTION
  DISAGREEMENT
}

// ==================== MODELS ====================

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  emailVerified   Boolean   @default(false)
  password        String?
  name            String
  type            UserType  @default(CITIZEN)
  verified        Boolean   @default(false)
  banned          Boolean   @default(false)
  reputation      Float     @default(0)
  avatarUrl       String?
  bio             String?
  phone           String?   // E.164, e.g. +5511999999999
  cpf             String?   // AES-256 encrypted

  // Address (filled via CEP lookup — BrasilAPI v2)
  zipCode         String?   // digits only, e.g. "01310100"
  street          String?
  streetNumber    String?
  complement      String?
  neighborhood    String?
  city            String?
  state           String?   // UF 2 chars, e.g. "SP"
  country         String    @default("BR")
  latitude        Float?
  longitude       Float?
  googleId        String?   @unique
  mfaEnabled           Boolean   @default(false)
  mfaSecret            String?
  mfaBackupCodes       String[]
  lastLoginAt              DateTime?
  inactivityNoticeSentAt   DateTime?
  failedLoginAttempts      Int       @default(0)
  lockedUntil              DateTime?
  mfaFailedAttempts        Int       @default(0)
  mfaLockedUntil           DateTime?
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?
  termsAcceptedAt          DateTime?
  termsVersion             String?
  privacyVersion           String?
  ageConfirmedAt           DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reports              Report[]         @relation("ReportAuthor")
  votes                Vote[]
  comments             Comment[]
  timelineEvents       TimelineEvent[]
  notifications        Notification[]
  registrationRequests RegistrationRequest[] @relation("RegistrationRequester")
  reviewedRequests     RegistrationRequest[] @relation("RegistrationReviewer")
  memberships          OrgMembership[]
  apiKeys              ApiKey[]
  propostaTimeline     PropostaTimeline[]
  propostaVotos        PropostaVoto[]

  politicianFollows    UserPoliticianFollower[]
  debateQuestions      DebateQuestion[]
  debateMessages       DebateMessage[]
  debatePollVotes      DebatePollVote[]
  moderationActions    ModerationAction[] @relation("ModerationActor")
  contentFlags         ContentFlag[]      @relation("FlagReporter")
  refreshTokens        RefreshToken[]

  @@map("users")
}

model Report {
  id               String         @id @default(uuid())
  title            String
  description      String
  category         Category
  status           ReportStatus   @default(OPEN)
  anonymous        Boolean        @default(false)

  // Location
  latitude         Float?
  longitude        Float?
  normalizedAddress String?
  city             String?
  cityKey          String?        @map("city_key")
  state            String?
  neighborhood     String?
  neighborhoodKey  String?        @map("neighborhood_key")
  cell7            String?

  firstResponseAt  DateTime?      @map("first_response_at")
  resolvedAt       DateTime?      @map("resolved_at")

  // Media (Cloudflare R2 URLs)
  media            String[]

  // Pressure score (calculated hourly by BullMQ job — section 8.3)
  pressureScore    Float          @default(0)

  // Polymorphic recipient (section 15.4)
  recipientType    RecipientType?
  recipientId      String?

  // Similarity search via pgvector — populated async by BullMQ job
  embedding        Unsupported("vector(768)")?

  // Author — NULL em relato anônimo: o vínculo autor↔relato NÃO é gravado (reports.service.ts / reports.repository.ts)
  authorId         String?
  author           User?          @relation("ReportAuthor", fields: [authorId], references: [id])

  // Manual grouping of similar reports in the same region
  groupId          String?
  group            ReportGroup?   @relation(fields: [groupId], references: [id])

  // Auto-grouping via surto detection (linked by alerts system)
  surtoId          String?
  surto            Surto?         @relation(fields: [surtoId], references: [id])

  timeline         TimelineEvent[]
  votes            Vote[]
  comments         Comment[]
  notifications    Notification[]
  followers        ReportFollower[]
  orgTags          OrgReportTag[]
  orgNotes         OrgReportNote[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([state, cityKey, createdAt])
  @@index([cell7, category, createdAt])
  @@index([recipientType, recipientId, createdAt])
  @@index([updatedAt])
  @@map("reports")
}

model ReportGroup {
  id        String   @id @default(uuid())
  reports   Report[]
  createdAt DateTime @default(now())

  @@map("report_groups")
}

// Immutable timeline — every action on a report generates a permanent event
model TimelineEvent {
  id        String    @id @default(uuid())
  reportId  String
  report    Report    @relation(fields: [reportId], references: [id])
  type      EventType
  content   String
  authorId  String?
  author    User?     @relation(fields: [authorId], references: [id])
  metadata  Json?
  createdAt DateTime  @default(now())

  @@map("timeline_events")
}

model Entity {
  id              String     @id @default(uuid())
  createdByUserId String?    // auditoria — não determina ownership (ver OrgMembership)
  legalName       String
  cnpj            String?    @unique  // opcional para entidades importadas via IBGE
  ibgeCode        String?    @unique  // código IBGE do município — identifica prefeituras importadas
  type            EntityType
  verified        Boolean    @default(false)
  votzScore            Float      @default(0)
  plan                 EntityPlan @default(BASICO)
  stripeCustomerId     String?    @unique
  stripeSubscriptionId String?    @unique
  slaHours             Json?      // { "HEALTH": 48, "MOBILITY": 72, ... }
  city            String?
  state           String?
  logoUrl         String?
  website         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("entities")
}

model Party {
  id           String       @id @default(uuid())
  name         String
  abbreviation String       @unique
  number       Int          @unique
  active       Boolean      @default(true)
  logoUrl      String?
  politicians  Politician[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("parties")
}

model Politician {
  id              String   @id @default(uuid())
  createdByUserId String?  // auditoria — não determina ownership (ver OrgMembership)
  name            String   @default("") // nome completo do político
  cpf             String?  @unique // AES-256 em app layer — chave de deduplicação
  tseId           String?  @unique // código oficial TSE (futuro: DivulgaCand)
  partyId         String
  party           Party    @relation(fields: [partyId], references: [id])
  office          String
  termStart       DateTime
  termEnd         DateTime
  electoralZone   String
  state           String
  city            String?
  avatarUrl       String?
  website         String?
  verified             Boolean          @default(false)
  status               PoliticianStatus @default(ATIVO)
  plan                 PoliticianPlan   @default(BASICO)
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?          @unique
  mandatometer         Json?            // snapshot: { resolved, ignored, advocated }
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  propostas            Proposta[]
  debatesCreated       Debate[]             @relation("DebatesCreated")
  debateParticipations DebateParticipant[]
  followers            UserPoliticianFollower[]

  @@map("politicians")
}

model Company {
  id        String        @id @default(uuid())
  legalName String
  tradeName String
  cnpj      String        @unique
  sector    CompanySector
  size      CompanySize
  verified             Boolean       @default(false)
  plan                 CompanyPlan   @default(STARTER)
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  votzScore            Float         @default(0)
  slaHours  Int           @default(48)
  logoUrl   String?
  website   String?
  branches  Branch[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("companies")
}

model Branch {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  address      String
  city         String
  state        String
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())

  @@map("branches")
}

model Vote {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      VoteType @default(SUPPORT)
  createdAt DateTime @default(now())

  @@unique([reportId, userId, type])
  @@map("votes")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  read      Boolean          @default(false)
  reportId  String?
  report    Report?          @relation(fields: [reportId], references: [id])
  metadata  Json?
  createdAt DateTime         @default(now())

  @@map("notifications")
}

model RegistrationRequest {
  id              String                    @id @default(uuid())
  type            RegistrationRequestType
  status          RegistrationRequestStatus @default(PENDING)
  requesterId     String
  requester       User                      @relation("RegistrationRequester", fields: [requesterId], references: [id])
  payload         Json
  note            String?  @db.VarChar(500)
  claimTargetId   String?  // id do org existente a ser reivindicado (fluxo claim)
  reviewerId      String?
  reviewer        User?                     @relation("RegistrationReviewer", fields: [reviewerId], references: [id])
  reviewNote      String?
  approvedOrgId   String?  // id do org criado/reivindicado na aprovação
  approvedOrgType OrgType? // tipo do org criado/reivindicado
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@map("registration_requests")
}

model Comment {
  id        String    @id @default(uuid())
  reportId  String
  report    Report    @relation(fields: [reportId], references: [id])
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  content       String
  parentId      String?
  parent        Comment?         @relation("CommentReply", fields: [parentId], references: [id])
  replies       Comment[]        @relation("CommentReply")

  mediaType     CommentMediaType @default(TEXT)
  mediaUrl      String?
  mediaKey      String?
  mediaDuration Int?
  transcript    String?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("comments")
}

// ==================== RBAC / ORG MEMBERSHIP ====================

// Role template owned by an org — permissions is a bitmask stored as a list
model OrgRole {
  id          String          @id @default(uuid())
  orgType     OrgType
  orgId       String
  name        String          // e.g. "Atendente", "Gestor"
  permissions OrgPermission[]
  isDefault   Boolean         @default(false) // pre-built role (OWNER, MANAGER, AGENT, VIEWER)
  memberships OrgMembership[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([orgType, orgId, name])
  @@map("org_roles")
}

// Ties a User to an org via a Role
model OrgMembership {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  orgType   OrgType
  orgId     String
  roleId    String
  role      OrgRole          @relation(fields: [roleId], references: [id])
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, orgType, orgId])
  @@map("org_memberships")
}

// ── Surto ────────────────────────────────────────────────────────────────────
// Alerta de problema em escala: detectado quando N+ relatos da mesma categoria
// aparecem na mesma cidade nas últimas 24 horas.
model Surto {
  id         String   @id @default(cuid())
  category   Category
  city       String
  state      String
  count      Int
  active     Boolean  @default(true)
  detectedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  reports    Report[]

  @@unique([category, city])
  @@map("surtos")
}

// Politician or entity explicitly following a report for notifications/visibility
model ReportFollower {
  id        String            @id @default(uuid())
  reportId  String
  report    Report            @relation(fields: [reportId], references: [id])
  actorType FollowerActorType
  actorId   String            // politician.id or entity.id
  createdAt DateTime          @default(now())

  @@unique([reportId, actorType, actorId])
  @@index([actorType, actorId])
  @@map("report_followers")
}

// API keys — used by the public API (section 3.6 / 10)
model ApiKey {
  id         String     @id @default(uuid())
  name       String
  keyHash    String     @unique
  prefix     String                     // first 12 chars for safe display
  tier       ApiKeyTier @default(FREE)
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
  @@map("api_keys")
}

// Pending invite — resolved when the invitee clicks the link
model MemberInvite {
  id          String    @id @default(uuid())
  orgType     OrgType
  orgId       String
  email       String
  roleId      String
  token       String    @unique @default(uuid())
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@map("member_invites")
}

// ==================== PROPOSTAS ====================

model Proposta {
  id          String         @id @default(uuid())
  titulo      String
  descricao   String
  status      PropostaStatus @default(DRAFT)
  categorias  Category[]
  linkExterno String?

  politicoId  String
  politico    Politician     @relation(fields: [politicoId], references: [id])

  timeline    PropostaTimeline[]
  votos       PropostaVoto[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("propostas")
}

model PropostaTimeline {
  id         String            @id @default(uuid())
  propostaId String
  proposta   Proposta          @relation(fields: [propostaId], references: [id])
  tipo       PropostaEventType
  conteudo   String
  autorId    String?
  autor      User?             @relation(fields: [autorId], references: [id])
  metadata   Json?
  createdAt  DateTime          @default(now())

  @@map("proposta_timeline")
}

model PropostaVoto {
  id         String   @id @default(uuid())
  propostaId String
  proposta   Proposta @relation(fields: [propostaId], references: [id])
  usuarioId  String
  usuario    User     @relation(fields: [usuarioId], references: [id])
  apoio      Boolean  // true = apoia, false = rejeita
  createdAt  DateTime @default(now())

  @@unique([propostaId, usuarioId])
  @@map("proposta_votos")
}

// ==================== DEBATES ====================

model Debate {
  id               String       @id @default(cuid())
  title            String
  description      String?
  scheduledFor     DateTime
  status           DebateStatus @default(SCHEDULED)
  livekitRoomName  String?      @unique
  hlsUrl           String?
  recordingUrl     String?
  egressId         String?
  viewerCount      Int          @default(0)
  chatCooldownSecs Int          @default(5)

  creatorId        String
  creator          Politician   @relation("DebatesCreated", fields: [creatorId], references: [id])

  participants     DebateParticipant[]
  questions        DebateQuestion[]
  reactions        DebateReaction[]
  messages         DebateMessage[]
  polls            DebatePoll[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("debates")
}

model DebateParticipant {
  id           String          @id @default(cuid())
  debateId     String
  politicianId String
  role         ParticipantRole @default(DEBATER)
  inviteStatus InviteStatus    @default(PENDING)
  createdAt    DateTime        @default(now())

  debate       Debate     @relation(fields: [debateId], references: [id], onDelete: Cascade)
  politician   Politician @relation(fields: [politicianId], references: [id])

  @@unique([debateId, politicianId])
  @@map("debate_participants")
}

model DebateQuestion {
  id        String   @id @default(cuid())
  debateId  String
  authorId  String
  text      String   @db.VarChar(500)
  upvotes   Int      @default(0)
  answered  Boolean  @default(false)
  createdAt DateTime @default(now())

  debate    Debate @relation(fields: [debateId], references: [id], onDelete: Cascade)
  author    User   @relation(fields: [authorId], references: [id])

  @@map("debate_questions")
}

model DebateReaction {
  id        String       @id @default(cuid())
  debateId  String
  type      ReactionType
  createdAt DateTime     @default(now())

  debate    Debate @relation(fields: [debateId], references: [id], onDelete: Cascade)

  @@map("debate_reactions")
}

model DebateMessage {
  id        String   @id @default(cuid())
  debateId  String
  authorId  String
  text      String   @db.VarChar(500)
  createdAt DateTime @default(now())

  debate    Debate @relation(fields: [debateId], references: [id], onDelete: Cascade)
  author    User   @relation(fields: [authorId], references: [id])

  @@map("debate_messages")
}

model DebatePoll {
  id        String             @id @default(cuid())
  debateId  String
  question  String
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())

  debate    Debate             @relation(fields: [debateId], references: [id], onDelete: Cascade)
  options   DebatePollOption[]
  votes     DebatePollVote[]

  @@map("debate_polls")
}

model DebatePollOption {
  id         String           @id @default(cuid())
  pollId     String
  text       String
  totalVotes Int              @default(0)

  poll       DebatePoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes      DebatePollVote[]

  @@map("debate_poll_options")
}

model DebatePollVote {
  id       String @id @default(cuid())
  pollId   String
  optionId String
  userId   String

  poll     DebatePoll       @relation(fields: [pollId], references: [id])
  option   DebatePollOption @relation(fields: [optionId], references: [id])
  user     User             @relation(fields: [userId], references: [id])

  @@unique([pollId, userId])
  @@map("debate_poll_votes")
}

model UserPoliticianFollower {
  id           String     @id @default(cuid())
  userId       String
  politicianId String
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  politician   Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  @@unique([userId, politicianId])
  @@map("user_politician_followers")
}

enum AccessEvent {
  REGISTER
  LOGIN
  GOOGLE_LOGIN
  MFA_LOGIN
  TOKEN_REFRESH
}

model AccessLog {
  id        String      @id @default(uuid())
  userId    String?     // SEM relação/FK: o log precisa sobreviver à exclusão da conta (obrigação legal)
  event     AccessEvent
  ip        String
  createdAt DateTime    @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("access_logs")
}

enum ModerationActionType {
  REPORT_REMOVED
  COMMENT_REMOVED
  USER_BANNED
  USER_UNBANNED
  USER_TYPE_CHANGED
  API_KEY_TIER_CHANGED
  ORG_ITEM_CREATED
  ORG_ITEM_DELETED
}

model ModerationAction {
  id         String               @id @default(uuid())
  action     ModerationActionType
  targetType String               // "REPORT" | "COMMENT" | "USER"
  targetId   String
  reason     String               // motivo escrito pelo moderador (obrigatório ao remover/banir)
  actorId    String?              // quem moderou
  actor      User?                @relation("ModerationActor", fields: [actorId], references: [id], onDelete: SetNull)
  notifiedAt DateTime?            // quando o autor foi avisado (nulo se não havia a quem avisar)
  createdAt  DateTime             @default(now())

  @@index([targetType, targetId])
  @@map("moderation_actions")
}

enum FlagTargetType {
  REPORT
  COMMENT
}

enum FlagReason {
  FALSE_INFO
  OFFENSIVE
  PERSONAL_DATA
  SEXUAL_OR_VIOLENT
  SPAM_OR_ADS
  FAKE_PROFILE
  COPYRIGHT
  OTHER
}

enum FlagStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model ContentFlag {
  id             String         @id @default(uuid())
  targetType     FlagTargetType
  targetId       String
  reason         FlagReason
  details        String?        @db.VarChar(500)
  status         FlagStatus     @default(OPEN)
  reporterId     String?
  reporter       User?          @relation("FlagReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?        @db.VarChar(500)
  createdAt      DateTime       @default(now())

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@map("content_flags")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_events")
}

// ==================== ANALYTICS ROLLUPS (BRIEF 4B) ====================

model AreaMetricDaily {
  id                      String   @id @default(uuid())
  day                     DateTime @db.Date
  state                   String
  cityKey                 String   @map("city_key")
  cityDisplay             String   @default("") @map("city_display")
  cell7                   String?
  category                Category
  createdCount            Int      @default(0) @map("created_count")
  resolvedCount           Int      @default(0) @map("resolved_count")
  openCurrentCount        Int      @default(0) @map("open_current_count")
  contestedCount          Int      @default(0) @map("contested_count")
  responseCount           Int      @default(0) @map("response_count")
  resolutionDurationCount Int      @default(0) @map("resolution_duration_count")
  respBuckets             Int[]    @default([0, 0, 0, 0, 0, 0, 0, 0]) @map("resp_buckets")
  resBuckets              Int[]    @default([0, 0, 0, 0, 0, 0, 0, 0]) @map("res_buckets")
  pressureBuckets         Int[]    @default([0, 0, 0, 0, 0, 0, 0, 0, 0]) @map("pressure_buckets")
  pressureSum             Float    @default(0) @map("pressure_sum")
  supportCount            Int      @default(0) @map("support_count")
  commentCount            Int      @default(0) @map("comment_count")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@index([state, cityKey, day])
  @@index([state, day, category])
  @@index([state, cityKey, cell7, day])
  @@index([day])
  @@map("area_metrics_daily")
}

model RecipientMetricDaily {
  id                      String        @id @default(uuid())
  day                     DateTime      @db.Date
  recipientType           RecipientType @map("recipient_type")
  recipientId             String        @map("recipient_id")
  category                Category
  createdCount            Int           @default(0) @map("created_count")
  resolvedCount           Int           @default(0) @map("resolved_count")
  openCurrentCount        Int           @default(0) @map("open_current_count")
  contestedCount          Int           @default(0) @map("contested_count")
  responseCount           Int           @default(0) @map("response_count")
  resolutionDurationCount Int           @default(0) @map("resolution_duration_count")
  respBuckets             Int[]         @default([0, 0, 0, 0, 0, 0, 0, 0]) @map("resp_buckets")
  resBuckets              Int[]         @default([0, 0, 0, 0, 0, 0, 0, 0]) @map("res_buckets")
  pressureBuckets         Int[]         @default([0, 0, 0, 0, 0, 0, 0, 0, 0]) @map("pressure_buckets")
  pressureSum             Float         @default(0) @map("pressure_sum")
  supportCount            Int           @default(0) @map("support_count")
  commentCount            Int           @default(0) @map("comment_count")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  @@unique([day, recipientType, recipientId, category])
  @@index([recipientType, recipientId, day])
  @@map("recipient_metrics_daily")
}

model RecurrenceCell {
  id         String   @id @default(uuid())
  state      String
  cityKey    String   @map("city_key")
  cell7      String
  category   Category
  windowEnd  DateTime @db.Date @map("window_end")
  count90d   Int      @map("count_90d")
  firstSeen  DateTime @map("first_seen")
  lastSeen   DateTime @map("last_seen")
  avgGapDays Float?   @map("avg_gap_days")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([cell7, category, windowEnd])
  @@index([state, cityKey, windowEnd, count90d])
  @@index([state, windowEnd, count90d])
  @@map("recurrence_cells")
}

enum AlertRuleType {
  NEW_REPORT
  PRESSURE_THRESHOLD
  SURTO
  STALLED_REPORT
}

enum AlertChannel {
  IN_APP
  EMAIL
}

enum AlertFrequency {
  IMMEDIATE
  DAILY_DIGEST
}

enum AccountabilityReportStatus {
  PENDING
  READY
  FAILED
}

enum ShareCardFormat {
  FEED
  STORIES
}

enum WebhookEventType {
  REPORT_CREATED
  REPORT_STATUS_CHANGED
  REPORT_PRESSURE_THRESHOLD
  OUTBREAK_DETECTED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

model MandateSettings {
  id                         String    @id @default(uuid())
  orgType                    OrgType   @map("org_type")
  orgId                      String    @map("org_id")
  monthlyGoal                Int?      @map("monthly_goal")
  digestEnabled              Boolean   @default(false) @map("digest_enabled")
  digestDayOfWeek            Int       @default(1) @map("digest_day_of_week")
  digestHour                 Int       @default(8) @map("digest_hour")
  digestUnsubscribeToken     String    @unique @map("digest_unsubscribe_token")
  digestLegalBasis           String?   @map("digest_legal_basis")
  digestLegalBasisAcceptedAt DateTime? @map("digest_legal_basis_accepted_at")
  digestLastSentWeek         String?   @map("digest_last_sent_week")
  onboardingDismissed        Boolean   @default(false) @map("onboarding_dismissed")
  territoryConfirmedAt       DateTime? @map("territory_confirmed_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@unique([orgType, orgId])
  @@map("mandate_settings")
}

model AlertRule {
  id          String            @id @default(uuid())
  orgType     OrgType           @map("org_type")
  orgId       String            @map("org_id")
  name        String
  ruleType    AlertRuleType     @map("rule_type")
  categories  Category[]
  cell7s      String[]
  wholeArea   Boolean           @default(true) @map("whole_area")
  minPressure Float?            @map("min_pressure")
  stalledDays Int?              @map("stalled_days")
  channels    AlertChannel[]
  frequency   AlertFrequency    @default(IMMEDIATE)
  active      Boolean           @default(true)
  createdById String?           @map("created_by_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  triggers AlertTriggerLog[]

  @@index([orgType, orgId, active])
  @@map("alert_rules")
}

model AlertTriggerLog {
  id           String    @id @default(uuid())
  ruleId       String    @map("rule_id")
  rule         AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  reportId     String?   @map("report_id")
  surtoId      String?   @map("surto_id")
  dedupKey     String    @unique @map("dedup_key")
  batchKey     String?   @map("batch_key")
  digestSentAt DateTime? @map("digest_sent_at")
  deliveredAt  DateTime  @default(now()) @map("delivered_at")

  @@index([ruleId, deliveredAt])
  @@index([batchKey, digestSentAt])
  @@map("alert_trigger_logs")
}

model ReplyTemplate {
  id          String    @id @default(uuid())
  orgType     OrgType   @map("org_type")
  orgId       String    @map("org_id")
  title       String
  body        String
  category    Category?
  usageCount  Int       @default(0) @map("usage_count")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([orgType, orgId])
  @@map("reply_templates")
}

model OrgReportTag {
  id          String   @id @default(uuid())
  orgType     OrgType  @map("org_type")
  orgId       String   @map("org_id")
  reportId    String   @map("report_id")
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  label       String
  color       String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([orgType, orgId, reportId, label])
  @@index([orgType, orgId, reportId])
  @@map("org_report_tags")
}

model OrgReportNote {
  id          String   @id @default(uuid())
  orgType     OrgType  @map("org_type")
  orgId       String   @map("org_id")
  reportId    String   @map("report_id")
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  content     String
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([orgType, orgId, reportId])
  @@map("org_report_notes")
}

model AccountabilityReport {
  id                String                     @id @default(uuid())
  code              String                     @unique
  orgType           OrgType                    @map("org_type")
  orgId             String                     @map("org_id")
  periodStart       String                     @map("period_start")
  periodEnd         String                     @map("period_end")
  dictionaryVersion String                     @map("dictionary_version")
  computedAt        DateTime                   @map("computed_at")
  snapshot          Json
  pdfKey            String?                    @map("pdf_key")
  pdfExpiresAt      DateTime?                  @map("pdf_expires_at")
  status            AccountabilityReportStatus @default(PENDING)
  errorMessage      String?                    @map("error_message")
  createdById       String?                    @map("created_by_id")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  @@index([orgType, orgId, createdAt])
  @@map("accountability_reports")
}

model ShareCardCache {
  id           String          @id @default(uuid())
  politicianId String          @map("politician_id")
  format       ShareCardFormat
  periodStart  String          @map("period_start")
  periodEnd    String          @map("period_end")
  metricsHash  String          @map("metrics_hash")
  imageKey     String          @map("image_key")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@unique([politicianId, format, periodStart, periodEnd, metricsHash])
  @@index([politicianId, createdAt])
  @@map("share_card_cache")
}

model WebhookEndpoint {
  id                  String             @id @default(uuid())
  orgType             OrgType            @map("org_type")
  orgId               String             @map("org_id")
  url                 String
  events              WebhookEventType[]
  secretEncrypted     String             @map("secret_encrypted")
  secretPrefix        String             @map("secret_prefix")
  active              Boolean            @default(true)
  consecutiveFailures Int                @default(0) @map("consecutive_failures")
  disabledReason      String?            @map("disabled_reason")
  createdById         String?            @map("created_by_id")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]

  @@index([orgType, orgId, active])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id           String                @id @default(uuid())
  endpointId   String                @map("endpoint_id")
  endpoint     WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventId      String                @map("event_id")
  eventType    WebhookEventType      @map("event_type")
  status       WebhookDeliveryStatus @default(PENDING)
  httpStatus   Int?                  @map("http_status")
  latencyMs    Int?                  @map("latency_ms")
  attemptCount Int                   @default(0) @map("attempt_count")
  errorMessage String?               @map("error_message")
  createdAt    DateTime              @default(now()) @map("created_at")
  deliveredAt  DateTime?             @map("delivered_at")

  @@unique([endpointId, eventId])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}
