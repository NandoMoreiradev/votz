generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ==================== ENUMS ====================

enum UserType {
  CITIZEN
  ENTITY
  POLITICIAN
  COMPANY
  PRESS
  NGO
  RESEARCHER
  MODERATOR
  ADMIN
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  DISPUTED
  ARCHIVED
}

enum EventType {
  CREATED
  RESPONDED
  STATUS_CHANGED
  UPDATE
  DISPUTED
  RESOLVED
  ARCHIVED
}

enum Category {
  HEALTH
  MOBILITY
  SAFETY
  EDUCATION
  SANITATION
  HOUSING
  ENVIRONMENT
  INFRASTRUCTURE
  URBAN_SERVICES
  CORRUPTION
  ACCESSIBILITY
  SOCIAL_WELFARE
  OTHER
}

enum EntityType {
  CITY_HALL
  HOSPITAL
  CONCESSIONAIRE
  AUTARCHY
  SECRETARIAT
  OTHER
}

enum CompanySector {
  TELECOM
  SUPPLEMENTAL_HEALTH
  FINANCIAL
  ENERGY
  TRANSPORTATION
  RETAIL
  FOOD
  CONDOMINIUM
  OTHER
}

enum CompanySize {
  MEI
  SMALL
  MEDIUM
  LARGE
}

enum CompanyPlan {
  STARTER
  BUSINESS
  ENTERPRISE
  WHITE_LABEL
}

enum EntityPlan {
  BASICO
  GESTAO
  PRO
  ENTERPRISE
}

enum PoliticianPlan {
  BASICO
  MANDATOMETRO_PRO
  CAMPANHA
}

enum RecipientType {
  ENTITY
  COMPANY
  BRANCH
  POLITICIAN
}

enum VoteType {
  SUPPORT
  ME_TOO
}

enum OrgType {
  ENTITY
  POLITICIAN
  COMPANY
}

enum OrgPermission {
  RESPOND_REPORTS
  MANAGE_MEMBERS
  MANAGE_PROFILE
  VIEW_ANALYTICS
  EXPORT_DATA
  MANAGE_BRANCHES
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum RegistrationRequestType {
  ENTITY
  POLITICIAN
  COMPANY
}

enum RegistrationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  NEW_COMMENT
  STATUS_CHANGED
  SURTO_DETECTED
}

enum ApiKeyTier {
  FREE
  PAID
}

enum FollowerActorType {
  POLITICIAN
  ENTITY
}

enum PropostaStatus {
  DRAFT
  PRESENTED
  IN_VOTE
  APPROVED
  REJECTED
  ARCHIVED
}

enum PropostaEventType {
  CREATED
  STATUS_CHANGED
  UPDATED
}

enum CommentMediaType {
  TEXT
  AUDIO
  VIDEO
}

// ==================== MODELS ====================

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  emailVerified   Boolean   @default(false)
  password        String?
  name            String
  type            UserType  @default(CITIZEN)
  verified        Boolean   @default(false)
  banned          Boolean   @default(false)
  reputation      Float     @default(0)
  avatarUrl       String?
  bio             String?
  phone           String?   // E.164, e.g. +5511999999999
  cpf             String?   // AES-256 encrypted

  // Address (filled via CEP lookup — BrasilAPI v2)
  zipCode         String?   // digits only, e.g. "01310100"
  street          String?
  streetNumber    String?
  complement      String?
  neighborhood    String?
  city            String?
  state           String?   // UF 2 chars, e.g. "SP"
  country         String    @default("BR")
  latitude        Float?
  longitude       Float?
  googleId        String?   @unique
  mfaEnabled           Boolean   @default(false)
  mfaSecret            String?
  mfaBackupCodes       String[]
  lastLoginAt          DateTime?
  refreshTokenHash     String?
  failedLoginAttempts      Int       @default(0)
  lockedUntil              DateTime?
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reports              Report[]         @relation("ReportAuthor")
  votes                Vote[]
  comments             Comment[]
  timelineEvents       TimelineEvent[]
  notifications        Notification[]
  registrationRequests RegistrationRequest[] @relation("RegistrationRequester")
  reviewedRequests     RegistrationRequest[] @relation("RegistrationReviewer")
  memberships          OrgMembership[]
  apiKeys              ApiKey[]
  propostaTimeline     PropostaTimeline[]
  propostaVotos        PropostaVoto[]

  @@map("users")
}

model Report {
  id               String         @id @default(uuid())
  title            String
  description      String
  category         Category
  status           ReportStatus   @default(OPEN)
  anonymous        Boolean        @default(false)

  // Location
  latitude         Float?
  longitude        Float?
  normalizedAddress String?
  city             String?
  state            String?
  neighborhood     String?

  // Media (Cloudflare R2 URLs)
  media            String[]

  // Pressure score (calculated hourly by BullMQ job — section 8.3)
  pressureScore    Float          @default(0)

  // Polymorphic recipient (section 15.4)
  recipientType    RecipientType?
  recipientId      String?

  // Similarity search via pgvector — populated async by BullMQ job
  embedding        Unsupported("vector(768)")?

  // Author (null if anonymous — link exists in DB but never exposed in public queries)
  authorId         String?
  author           User?          @relation("ReportAuthor", fields: [authorId], references: [id])

  // Manual grouping of similar reports in the same region
  groupId          String?
  group            ReportGroup?   @relation(fields: [groupId], references: [id])

  // Auto-grouping via surto detection (linked by alerts system)
  surtoId          String?
  surto            Surto?         @relation(fields: [surtoId], references: [id])

  timeline         TimelineEvent[]
  votes            Vote[]
  comments         Comment[]
  notifications    Notification[]
  followers        ReportFollower[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("reports")
}

model ReportGroup {
  id        String   @id @default(uuid())
  reports   Report[]
  createdAt DateTime @default(now())

  @@map("report_groups")
}

// Immutable timeline — every action on a report generates a permanent event
model TimelineEvent {
  id        String    @id @default(uuid())
  reportId  String
  report    Report    @relation(fields: [reportId], references: [id])
  type      EventType
  content   String
  authorId  String?
  author    User?     @relation(fields: [authorId], references: [id])
  metadata  Json?
  createdAt DateTime  @default(now())

  @@map("timeline_events")
}

model Entity {
  id              String     @id @default(uuid())
  createdByUserId String?    // auditoria — não determina ownership (ver OrgMembership)
  legalName       String
  cnpj            String?    @unique  // opcional para entidades importadas via IBGE
  ibgeCode        String?    @unique  // código IBGE do município — identifica prefeituras importadas
  type            EntityType
  verified        Boolean    @default(false)
  votzScore            Float      @default(0)
  plan                 EntityPlan @default(BASICO)
  stripeCustomerId     String?    @unique
  stripeSubscriptionId String?    @unique
  slaHours             Json?      // { "HEALTH": 48, "MOBILITY": 72, ... }
  city            String?
  state           String?
  logoUrl         String?
  website         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("entities")
}

model Party {
  id           String       @id @default(uuid())
  name         String
  abbreviation String       @unique
  number       Int          @unique
  active       Boolean      @default(true)
  logoUrl      String?
  politicians  Politician[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("parties")
}

model Politician {
  id              String   @id @default(uuid())
  createdByUserId String?  // auditoria — não determina ownership (ver OrgMembership)
  name            String   @default("") // nome completo do político
  cpf             String?  @unique // AES-256 em app layer — chave de deduplicação
  tseId           String?  @unique // código oficial TSE (futuro: DivulgaCand)
  partyId         String
  party           Party    @relation(fields: [partyId], references: [id])
  office          String
  termStart       DateTime
  termEnd         DateTime
  electoralZone   String
  state           String
  city            String?
  avatarUrl       String?
  website         String?
  verified             Boolean        @default(false)
  plan                 PoliticianPlan @default(BASICO)
  stripeCustomerId     String?        @unique
  stripeSubscriptionId String?        @unique
  mandatometer         Json?          // snapshot: { resolved, ignored, advocated }
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  propostas       Proposta[]

  @@map("politicians")
}

model Company {
  id        String        @id @default(uuid())
  legalName String
  tradeName String
  cnpj      String        @unique
  sector    CompanySector
  size      CompanySize
  verified             Boolean       @default(false)
  plan                 CompanyPlan   @default(STARTER)
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  votzScore            Float         @default(0)
  slaHours  Int           @default(48)
  logoUrl   String?
  website   String?
  branches  Branch[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("companies")
}

model Branch {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  address      String
  city         String
  state        String
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())

  @@map("branches")
}

model Vote {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      VoteType @default(SUPPORT)
  createdAt DateTime @default(now())

  @@unique([reportId, userId, type])
  @@map("votes")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  read      Boolean          @default(false)
  reportId  String
  report    Report           @relation(fields: [reportId], references: [id])
  metadata  Json?
  createdAt DateTime         @default(now())

  @@map("notifications")
}

model RegistrationRequest {
  id              String                    @id @default(uuid())
  type            RegistrationRequestType
  status          RegistrationRequestStatus @default(PENDING)
  requesterId     String
  requester       User                      @relation("RegistrationRequester", fields: [requesterId], references: [id])
  payload         Json
  claimTargetId   String?  // id do org existente a ser reivindicado (fluxo claim)
  reviewerId      String?
  reviewer        User?                     @relation("RegistrationReviewer", fields: [reviewerId], references: [id])
  reviewNote      String?
  approvedOrgId   String?  // id do org criado/reivindicado na aprovação
  approvedOrgType OrgType? // tipo do org criado/reivindicado
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@map("registration_requests")
}

model Comment {
  id        String    @id @default(uuid())
  reportId  String
  report    Report    @relation(fields: [reportId], references: [id])
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  content       String
  parentId      String?
  parent        Comment?         @relation("CommentReply", fields: [parentId], references: [id])
  replies       Comment[]        @relation("CommentReply")

  mediaType     CommentMediaType @default(TEXT)
  mediaUrl      String?
  mediaKey      String?
  mediaDuration Int?
  transcript    String?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("comments")
}

// ==================== RBAC / ORG MEMBERSHIP ====================

// Role template owned by an org — permissions is a bitmask stored as a list
model OrgRole {
  id          String          @id @default(uuid())
  orgType     OrgType
  orgId       String
  name        String          // e.g. "Atendente", "Gestor"
  permissions OrgPermission[]
  isDefault   Boolean         @default(false) // pre-built role (OWNER, MANAGER, AGENT, VIEWER)
  memberships OrgMembership[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([orgType, orgId, name])
  @@map("org_roles")
}

// Ties a User to an org via a Role
model OrgMembership {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  orgType   OrgType
  orgId     String
  roleId    String
  role      OrgRole          @relation(fields: [roleId], references: [id])
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, orgType, orgId])
  @@map("org_memberships")
}

// ── Surto ────────────────────────────────────────────────────────────────────
// Alerta de problema em escala: detectado quando N+ relatos da mesma categoria
// aparecem na mesma cidade nas últimas 24 horas.
model Surto {
  id         String   @id @default(cuid())
  category   Category
  city       String
  state      String
  count      Int
  active     Boolean  @default(true)
  detectedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  reports    Report[]

  @@unique([category, city])
  @@map("surtos")
}

// Politician or entity explicitly following a report for notifications/visibility
model ReportFollower {
  id        String            @id @default(uuid())
  reportId  String
  report    Report            @relation(fields: [reportId], references: [id])
  actorType FollowerActorType
  actorId   String            // politician.id or entity.id
  createdAt DateTime          @default(now())

  @@unique([reportId, actorType, actorId])
  @@index([actorType, actorId])
  @@map("report_followers")
}

// API keys — used by the public API (section 3.6 / 10)
model ApiKey {
  id         String     @id @default(uuid())
  name       String
  keyHash    String     @unique
  prefix     String                     // first 12 chars for safe display
  tier       ApiKeyTier @default(FREE)
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
  @@map("api_keys")
}

// Pending invite — resolved when the invitee clicks the link
model MemberInvite {
  id          String    @id @default(uuid())
  orgType     OrgType
  orgId       String
  email       String
  roleId      String
  token       String    @unique @default(uuid())
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@map("member_invites")
}

// ==================== PROPOSTAS ====================

model Proposta {
  id          String         @id @default(uuid())
  titulo      String
  descricao   String
  status      PropostaStatus @default(DRAFT)
  categorias  Category[]
  linkExterno String?

  politicoId  String
  politico    Politician     @relation(fields: [politicoId], references: [id])

  timeline    PropostaTimeline[]
  votos       PropostaVoto[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("propostas")
}

model PropostaTimeline {
  id         String            @id @default(uuid())
  propostaId String
  proposta   Proposta          @relation(fields: [propostaId], references: [id])
  tipo       PropostaEventType
  conteudo   String
  autorId    String?
  autor      User?             @relation(fields: [autorId], references: [id])
  metadata   Json?
  createdAt  DateTime          @default(now())

  @@map("proposta_timeline")
}

model PropostaVoto {
  id         String   @id @default(uuid())
  propostaId String
  proposta   Proposta @relation(fields: [propostaId], references: [id])
  usuarioId  String
  usuario    User     @relation(fields: [usuarioId], references: [id])
  apoio      Boolean  // true = apoia, false = rejeita
  createdAt  DateTime @default(now())

  @@unique([propostaId, usuarioId])
  @@map("proposta_votos")
}
