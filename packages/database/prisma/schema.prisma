generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserType {
  CITIZEN
  ENTITY
  POLITICIAN
  PRESS
  NGO
  RESEARCHER
  MODERATOR
  ADMIN
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  DISPUTED
  ARCHIVED
}

enum EventType {
  CREATED
  RESPONDED
  STATUS_CHANGED
  DISPUTED
  RESOLVED
  ARCHIVED
}

enum Category {
  HEALTH
  MOBILITY
  SAFETY
  EDUCATION
  SANITATION
  HOUSING
  OTHER
}

enum EntityType {
  CITY_HALL
  HOSPITAL
  CONCESSIONAIRE
  AUTARCHY
  SECRETARIAT
  OTHER
}

enum CompanySector {
  TELECOM
  SUPPLEMENTAL_HEALTH
  FINANCIAL
  ENERGY
  TRANSPORTATION
  RETAIL
  FOOD
  CONDOMINIUM
  OTHER
}

enum CompanySize {
  MEI
  SMALL
  MEDIUM
  LARGE
}

enum CompanyPlan {
  STARTER
  BUSINESS
  ENTERPRISE
  WHITE_LABEL
}

enum RecipientType {
  ENTITY
  COMPANY
  BRANCH
  POLITICIAN
}

enum VoteType {
  SUPPORT
  ME_TOO
}

enum NotificationType {
  NEW_COMMENT
  STATUS_CHANGED
}

// ==================== MODELS ====================

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  emailVerified   Boolean   @default(false)
  password        String?
  name            String
  type            UserType  @default(CITIZEN)
  verified        Boolean   @default(false)
  banned          Boolean   @default(false)
  reputation      Float     @default(0)
  avatarUrl       String?
  bio             String?
  phone           String?   // normalized E.164 via libphonenumber-js
  cpf             String?   // AES-256 encrypted
  googleId        String?   @unique
  mfaEnabled           Boolean   @default(false)
  mfaSecret            String?
  mfaBackupCodes       String[]
  lastLoginAt          DateTime?
  refreshTokenHash     String?
  failedLoginAttempts      Int       @default(0)
  lockedUntil              DateTime?
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reports         Report[]  @relation("ReportAuthor")
  votes           Vote[]
  comments        Comment[]
  timelineEvents  TimelineEvent[]
  notifications   Notification[]
  entity          Entity?
  politician      Politician?

  @@map("users")
}

model Report {
  id               String         @id @default(uuid())
  title            String
  description      String
  category         Category
  status           ReportStatus   @default(OPEN)
  anonymous        Boolean        @default(false)

  // Location
  latitude         Float?
  longitude        Float?
  normalizedAddress String?
  city             String?
  state            String?
  neighborhood     String?

  // Media (Cloudflare R2 URLs)
  media            String[]

  // Pressure score (calculated hourly by BullMQ job — section 8.3)
  pressureScore    Float          @default(0)

  // Polymorphic recipient (section 15.4)
  recipientType    RecipientType?
  recipientId      String?

  // Author (null if anonymous — link exists in DB but never exposed in public queries)
  authorId         String?
  author           User?          @relation("ReportAuthor", fields: [authorId], references: [id])

  // Auto-grouping of similar reports in the same region
  groupId          String?
  group            ReportGroup?   @relation(fields: [groupId], references: [id])

  timeline         TimelineEvent[]
  votes            Vote[]
  comments         Comment[]
  notifications    Notification[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("reports")
}

model ReportGroup {
  id        String   @id @default(uuid())
  reports   Report[]
  createdAt DateTime @default(now())

  @@map("report_groups")
}

// Immutable timeline — every action on a report generates a permanent event
model TimelineEvent {
  id        String    @id @default(uuid())
  reportId  String
  report    Report    @relation(fields: [reportId], references: [id])
  type      EventType
  content   String
  authorId  String?
  author    User?     @relation(fields: [authorId], references: [id])
  metadata  Json?
  createdAt DateTime  @default(now())

  @@map("timeline_events")
}

model Entity {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  legalName String
  cnpj      String     @unique
  type      EntityType
  verified  Boolean    @default(false)
  votzScore Float      @default(0)
  slaHours  Json?      // { "HEALTH": 48, "MOBILITY": 72, ... }
  city      String?
  state     String?
  logoUrl   String?
  website   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("entities")
}

model Politician {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  party         String
  office        String
  termStart     DateTime
  termEnd       DateTime
  electoralZone String
  state         String
  city          String?
  verified      Boolean  @default(false)
  mandatometer  Json?    // snapshot: { resolved, ignored, advocated }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("politicians")
}

model Company {
  id        String        @id @default(uuid())
  legalName String
  tradeName String
  cnpj      String        @unique
  sector    CompanySector
  size      CompanySize
  verified  Boolean       @default(false)
  plan      CompanyPlan   @default(STARTER)
  votzScore Float         @default(0)
  slaHours  Int           @default(48)
  logoUrl   String?
  website   String?
  branches  Branch[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("companies")
}

model Branch {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  address      String
  city         String
  state        String
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())

  @@map("branches")
}

model Vote {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      VoteType @default(SUPPORT)
  createdAt DateTime @default(now())

  @@unique([reportId, userId, type])
  @@map("votes")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  read      Boolean          @default(false)
  reportId  String
  report    Report           @relation(fields: [reportId], references: [id])
  metadata  Json?
  createdAt DateTime         @default(now())

  @@map("notifications")
}

model Comment {
  id        String    @id @default(uuid())
  reportId  String
  report    Report    @relation(fields: [reportId], references: [id])
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  content   String
  parentId  String?
  parent    Comment?  @relation("CommentReply", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReply")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("comments")
}
