// ==================== MODELS ====================

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  emailVerified   Boolean   @default(false)
  password        String?
  name            String
  username        String?   @unique
  type            UserType  @default(CITIZEN)
  verified        Boolean   @default(false)
  banned          Boolean   @default(false)
  reputation      Float     @default(0)
  avatarUrl       String?
  coverUrl        String?   // capa do perfil (proporção 3:1, 1500x500)
  bio             String?
  phone           String?   // E.164, e.g. +5511999999999
  cpf             String?   // AES-256 encrypted

  // Address (filled via CEP lookup — BrasilAPI v2)
  zipCode         String?   // digits only, e.g. "01310100"
  street          String?
  streetNumber    String?
  complement      String?
  neighborhood    String?
  city            String?
  state           String?   // UF 2 chars, e.g. "SP"
  country         String    @default("BR")
  latitude        Float?
  longitude       Float?
  googleId        String?   @unique
  mfaEnabled           Boolean   @default(false)
  mfaSecret            String?
  mfaBackupCodes       String[]
  lastLoginAt              DateTime?
  inactivityNoticeSentAt   DateTime?
  failedLoginAttempts      Int       @default(0)
  lockedUntil              DateTime?
  mfaFailedAttempts        Int       @default(0)
  mfaLockedUntil           DateTime?
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?
  termsAcceptedAt          DateTime?
  termsVersion             String?
  privacyVersion           String?
  ageConfirmedAt           DateTime?
  // Opcionais (plano de anúncios, decisão 3). Nunca aparecem no perfil público; para anúncios só circulam
  // como faixa de idade e só com a personalização ligada (ver ADS_FEATURE_ALLOWLIST em @votz/shared-types).
  birthDate                DateTime?       @map("birth_date") @db.Date
  gender                   UserGender?
  themePreference          ThemePreference @default(SYSTEM) @map("theme_preference")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reports              Report[]         @relation("ReportAuthor")
  votes                Vote[]
  comments             Comment[]
  timelineEvents       TimelineEvent[]
  notifications        Notification[]
  registrationRequests RegistrationRequest[] @relation("RegistrationRequester")
  reviewedRequests     RegistrationRequest[] @relation("RegistrationReviewer")
  pressCredentials         PressCredential[] @relation("PressCredentialUser")
  reviewedPressCredentials PressCredential[] @relation("PressCredentialReviewer")
  pressRadarRules          PressRadarRule[]
  pressContactsSent        PressContactRequest[] @relation("PressContactSender")
  pressContactsReceived    PressContactRequest[] @relation("PressContactRecipient")
  pressContactBlocksMade   PressContactBlock[]   @relation("PressContactBlocker")
  pressContactBlocksGot    PressContactBlock[]   @relation("PressContactBlocked")
  memberships          OrgMembership[]
  apiKeys              ApiKey[]
  propostaTimeline     PropostaTimeline[]
  propostaVotos        PropostaVoto[]

  politicianFollows    UserPoliticianFollower[]
  entityFollows        UserEntityFollower[]
  companyFollows       UserCompanyFollower[]
  topicFollows         UserTopicFollower[]
  followingUsers       UserFollow[]             @relation("UserFollowing")
  followerUsers        UserFollow[]             @relation("UserFollowers")
  posts                Post[]                   @relation("PostAuthorUser")
  postLikes            PostLike[]
  postReposts          PostRepost[]
  postComments         PostComment[]
  postPollVotes        PostPollVote[]
  debateQuestions      DebateQuestion[]
  debateMessages       DebateMessage[]
  debatePollVotes      DebatePollVote[]
  moderationActions    ModerationAction[] @relation("ModerationActor")
  adReviews            AdReview[]         @relation("AdReviewer")
  contentFlags         ContentFlag[]      @relation("FlagReporter")
  refreshTokens        RefreshToken[]
  platformSuggestions      PlatformSuggestion[]     @relation("SuggestionAuthor")
  platformSuggestionVotes  PlatformSuggestionVote[]
  createdConversations     Conversation[] @relation("ConversationCreator")
  ownedConversations       Conversation[] @relation("ConversationOwner")
  conversationMembers      ConversationMember[] @relation("ConversationParticipant")
  conversationInvitations  ConversationMember[] @relation("ConversationInviter")
  conversationBlocksSent   ConversationBlock[] @relation("ConversationBlocker")
  pageConversations        PageConversation[]  @relation("PageConversationCitizen")
  pageMessagesSent         PageMessage[]       @relation("PageMessageSender")
  pageConversationReads    PageConversationRead[]
  conversationBlocksReceived ConversationBlock[] @relation("ConversationBlocked")
  conversationDeliveries   ConversationOutbox[]
  chatDevices              ChatDevice[]
  chatDeviceLinks          ChatDeviceLink[]
  chatPrivacy              ChatPrivacy?
  chatStorage              ChatStorage?
  adPreference               AdUserPreference?
  adImpressions              AdImpression[]
  adHiddenAdvertisers        AdHiddenAdvertiser[]
  chatKeyBackup            ChatKeyBackup?
  chatHistoryTransfers     ChatHistoryTransfer[]
  chatReceipts             ChatReceipt[]
  contextNotesAuthored     ContextNote[]          @relation("ContextNoteAuthor")
  contextNoteRatings       ContextNoteRating[]    @relation("ContextNoteRater")
  contextNoteRequests      ContextNoteRequest[]   @relation("ContextNoteRequester")
  contextContributor       ContextContributor?    @relation("ContextContributorUser")
  notificationPreference   UserNotificationPreference?

  @@map("users")
}

enum ConversationKind {
  DIRECT
  GROUP
}

enum ConversationMemberRole {
  ADMIN
  MEMBER
}

enum ConversationMemberState {
  INVITED
  ACTIVE
  DECLINED
  LEFT
  REMOVED
}

model Conversation {
  id              String @id @default(uuid())
  kind            ConversationKind
  matrixRoomId    String? @unique @map("matrix_room_id")
  title           String? @db.VarChar(100)
  directKey       String? @unique @map("direct_key")
  clientRequestId String? @map("client_request_id")
  requestHash     String? @map("request_hash")
  createdById     String? @map("created_by_id")
  createdBy       User? @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  ownerId         String? @map("owner_id")
  owner           User? @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  revision        Int @default(1)
  // Metadados da última mensagem (nunca o conteúdo, que o servidor não conhece).
  lastEventId     String? @map("last_event_id")
  lastEventAt     DateTime? @map("last_event_at")
  lastSenderId    String? @map("last_sender_id")
  archivedAt      DateTime? @map("archived_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  members         ConversationMember[]
  outbox          ConversationOutbox[]
  chatReceipts    ChatReceipt[]
  attachments     ChatAttachment[]

  @@unique([createdById, clientRequestId])
  @@index([updatedAt, id])
  @@map("conversations")
}

model ChatDevice {
  id String @id
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform String @db.VarChar(20)
  label String? @db.VarChar(60)
  secretHash String @map("secret_hash")
  matrixToken String @map("matrix_token")
  pushToken String? @map("push_token") @db.VarChar(255)
  pushTokenUpdatedAt DateTime? @map("push_token_updated_at")
  createdAt DateTime @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId, revokedAt])
  @@map("chat_devices")
}

// Pedido de vínculo de um novo aparelho: só vira dispositivo ativo depois que
// um aparelho já ativo da mesma conta aprova. O id é o do aparelho candidato.
model ChatDeviceLink {
  id String @id
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform String @db.VarChar(20)
  label String? @db.VarChar(60)
  secretHash String @map("secret_hash")
  code String @db.VarChar(6)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  decidedAt DateTime? @map("decided_at")
  approved Boolean?
  decidedByDeviceId String? @map("decided_by_device_id")

  @@index([userId, expiresAt])
  @@map("chat_device_links")
}

// Espaço de mídia das conversas liberado para a pessoa. Sem linha = cota padrão (CHAT_MEDIA_QUOTA_MB).
// Fica separado de ChatPrivacy de propósito: a pessoa edita a privacidade, mas não a própria cota.
model ChatStorage {
  userId    String   @id @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotaMb   Int      @map("quota_mb")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chat_storage")
}

model ChatPrivacy {
  userId                String    @id @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  readReceiptsEnabled   Boolean   @default(false) @map("read_receipts_enabled")
  lastSeenVisibility    String    @default("CONTACTS") @map("last_seen_visibility")
  lastSeenAt            DateTime? @map("last_seen_at")
  groupInvitePolicy     String    @default("EVERYONE") @map("group_invite_policy")
  directRequestPolicy   String    @default("EVERYONE") @map("direct_request_policy")
  notifySound           Boolean   @default(true) @map("notify_sound")
  notifyVibration       Boolean   @default(true) @map("notify_vibration")
  notifyPreview         Boolean   @default(false) @map("notify_preview")
  securityAlertsEnabled Boolean   @default(true) @map("security_alerts_enabled")
  keyBackupEnabled      Boolean   @default(false) @map("key_backup_enabled")
  mediaAutoDownload     String    @default("WIFI_ONLY") @map("media_auto_download")
  mediaUploadQuality    String    @default("NORMAL") @map("media_upload_quality")
  fontScale             String    @default("MEDIUM") @map("font_scale")
  wallpaper             String    @default("DEFAULT") @map("wallpaper")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("chat_privacy")
}

model ChatReceipt {
  conversationId String @map("conversation_id")
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  eventId String @map("event_id")
  recipientUserId String @map("recipient_user_id")
  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  deliveredAt DateTime @default(now()) @map("delivered_at")
  readAt DateTime? @map("read_at")

  @@id([conversationId, eventId, recipientUserId])
  @@index([conversationId, recipientUserId])
  @@map("chat_receipts")
}

// Anexo cifrado de ponta a ponta (bytes opacos no bucket privado; chave fica só no evento Megolm).
model ChatAttachment {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  uploaderId     String       @map("uploader_id")
  objectKey      String       @unique @map("object_key")
  sizeBytes      Int          @map("size_bytes")
  // Tipo grosso (IMAGE, VIDEO, AUDIO, FILE) informado pelo app, só para a tela de armazenamento.
  kind           String       @default("FILE")
  createdAt      DateTime     @default(now()) @map("created_at")
  // Nulo = sem prazo: o limite é a cota de armazenamento de quem enviou (mais antigos saem primeiro).
  expiresAt      DateTime?    @map("expires_at")
  deletedAt      DateTime?    @map("deleted_at")

  @@index([conversationId, createdAt])
  @@index([expiresAt, deletedAt])
  @@index([uploaderId, deletedAt, createdAt])
  @@map("chat_attachments")
}

// Cópia cifrada de histórico na nuvem: o servidor guarda apenas o cofre opaco
// produzido pelo SDK Matrix (PBKDF2 + AES-256-CTR + HMAC-SHA256) com a senha da pessoa.
model ChatKeyBackup {
  userId    String   @id @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vault     String   @db.Text
  sizeBytes Int      @map("size_bytes")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chat_key_backups")
}

// Transferência temporária de histórico entre aparelhos da mesma conta: uso único,
// cifrada no aparelho remetente com código temporário que nunca vai ao servidor.
model ChatHistoryTransfer {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromDeviceId String   @map("from_device_id")
  vault        String   @db.Text
  sizeBytes    Int      @map("size_bytes")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("chat_history_transfers")
}

model ConversationMember {
  id             String @id @default(uuid())
  conversationId String @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String @map("user_id")
  user           User @relation("ConversationParticipant", fields: [userId], references: [id], onDelete: Cascade)
  invitedById    String? @map("invited_by_id")
  invitedBy      User? @relation("ConversationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  role           ConversationMemberRole @default(MEMBER)
  state          ConversationMemberState @default(INVITED)
  // Mensagens recebidas desde a última vez que a pessoa abriu a conversa.
  unreadCount    Int @default(0) @map("unread_count")
  // Quando preenchido e no futuro, notificações push desta conversa ficam silenciadas.
  mutedUntil     DateTime? @map("muted_until")
  // Quando preenchido, fixa a conversa no topo da lista do participante.
  pinnedAt       DateTime? @map("pinned_at")
  joinedAt       DateTime? @map("joined_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([conversationId, userId])
  @@index([userId, state, conversationId])
  @@map("conversation_members")
}

model ConversationBlock {
  id        String @id @default(uuid())
  blockerId String @map("blocker_id")
  blocker   User @relation("ConversationBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String @map("blocked_id")
  blocked   User @relation("ConversationBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("conversation_blocks")
}

model ConversationOutbox {
  id              String @id @default(uuid())
  conversationId  String @map("conversation_id")
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  recipientUserId String @map("recipient_user_id")
  recipient       User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  revision        Int
  attempts        Int @default(0)
  nextAttemptAt   DateTime @default(now()) @map("next_attempt_at")
  sentAt          DateTime? @map("sent_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([conversationId, recipientUserId, revision])
  @@index([sentAt, nextAttemptAt])
  @@map("conversation_outbox")
}

// Cada arquivo enviado para relato (foto, vídeo, PDF). Serve para saber o que foi usado e apagar o que
// ninguém anexou (attachedAt nulo depois do prazo). Arquivos de antes desta tabela não têm linha.
// Sem relação com User de propósito: a limpeza do bucket não pode depender da conta continuar existindo.
model ReportMedia {
  id                String    @id @default(uuid())
  key               String    @unique
  uploaderId        String    @map("uploader_id")
  // IMAGE, VIDEO, PDF ou AUDIO.
  kind              String
  mimeType          String    @map("mime_type")
  sizeBytes         Int       @map("size_bytes")
  // Tamanho do que a pessoa enviou, antes de o servidor reduzir a foto.
  originalSizeBytes Int       @map("original_size_bytes")
  width             Int?
  height            Int?
  hasThumb          Boolean   @default(false) @map("has_thumb")
  durationMs        Int?      @map("duration_ms")
  // UPLOADING: envio direto ao bucket ainda não confirmado (o arquivo está em pending/, a chave já está reservada).
  // Conversão do vídeo para 1080p: NONE (não é vídeo), PENDING (na fila), DONE (convertido),
  // SKIPPED (já estava bom ou a conversão não compensou) ou FAILED (ficou o original).
  processing        String    @default("NONE")
  createdAt         DateTime  @default(now()) @map("created_at")
  attachedAt        DateTime? @map("attached_at")

  @@index([attachedAt, createdAt])
  @@index([processing, createdAt])
  @@index([uploaderId, createdAt])
  @@map("report_media")
}

model Report {
  id               String         @id @default(uuid())
  title            String
  description      String
  category         Category
  status           ReportStatus   @default(OPEN)
  anonymous        Boolean        @default(false)
  // O autor (relato público) aceita receber pedido de contato da imprensa credenciada. Nunca vale em relato anônimo.
  pressContactOk   Boolean        @default(false) @map("press_contact_ok")

  // Location
  latitude         Float?
  longitude        Float?
  normalizedAddress String?
  city             String?
  cityKey          String?        @map("city_key")
  state            String?
  neighborhood     String?
  neighborhoodKey  String?        @map("neighborhood_key")
  cell7            String?

  firstResponseAt  DateTime?      @map("first_response_at")
  resolvedAt       DateTime?      @map("resolved_at")

  // SLA (Brief 4D)
  slaStartedAt       DateTime?    @map("sla_started_at")
  slaDueAt           DateTime?    @map("sla_due_at")
  slaState           SlaState?    @map("sla_state")
  slaMetAt           DateTime?    @map("sla_met_at")
  resolutionSlaDueAt DateTime?    @map("resolution_sla_due_at")
  resolutionSlaState SlaState?    @map("resolution_sla_state")
  resolutionSlaMetAt DateTime?    @map("resolution_sla_met_at")

  // Media (Cloudflare R2 URLs)
  media            String[]

  // Pressure score (calculated hourly by BullMQ job — section 8.3)
  pressureScore    Float            @default(0)

  // Triagem automática de segurança (quarentena separada do ciclo cívico OPEN/RESOLVED)
  moderationStatus ModerationStatus @default(PUBLISHED) @map("moderation_status")

  // Polymorphic recipient (section 15.4)
  recipientType    RecipientType?
  recipientId      String?

  // Similarity search via pgvector — populated async by BullMQ job
  embedding        Unsupported("vector(768)")?

  // Author — NULL em relato anônimo: o vínculo autor↔relato NÃO é gravado (reports.service.ts / reports.repository.ts)
  authorId         String?
  author           User?          @relation("ReportAuthor", fields: [authorId], references: [id])

  // Manual grouping of similar reports in the same region
  groupId          String?
  group            ReportGroup?   @relation(fields: [groupId], references: [id])

  // Auto-grouping via surto detection (linked by alerts system)
  surtoId          String?
  surto            Surto?         @relation(fields: [surtoId], references: [id])

  timeline         TimelineEvent[]
  votes            Vote[]
  comments         Comment[]
  notifications    Notification[]
  followers        ReportFollower[]
  pressContactRequests PressContactRequest[]
  orgTags          OrgReportTag[]
  orgNotes         OrgReportNote[]
  assignments      OrgReportAssignment[]
  mentionedInPosts Post[]
  topics           ReportTopic[]
  contextNotes     ContextNote[]
  contextRequests  ContextNoteRequest[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([state, cityKey, createdAt])
  @@index([cell7, category, createdAt])
  @@index([recipientType, recipientId, createdAt])
  @@index([recipientType, recipientId, slaState, slaDueAt])
  @@index([slaState, slaDueAt])
  @@index([updatedAt])
  @@map("reports")
}

model ReportGroup {
  id        String   @id @default(uuid())
  reports   Report[]
  createdAt DateTime @default(now())

  @@map("report_groups")
}

// Immutable timeline — every action on a report generates a permanent event
model TimelineEvent {
  id        String    @id @default(uuid())
  reportId  String
  report    Report    @relation(fields: [reportId], references: [id])
  type      EventType
  content   String
  authorId  String?
  author    User?     @relation(fields: [authorId], references: [id])
  metadata  Json?
  createdAt DateTime  @default(now())

  @@map("timeline_events")
}

model Entity {
  id              String     @id @default(uuid())
  createdByUserId String?    // auditoria — não determina ownership (ver OrgMembership)
  legalName       String
  username        String?    @unique  // @ da página; único em todo o Votz (ver HandlesService)
  cnpj            String?    @unique  // opcional para entidades importadas via IBGE
  ibgeCode        String?    @unique  // código IBGE do município — identifica prefeituras importadas
  type            EntityType
  verified        Boolean    @default(false)
  votzScore            Float      @default(0)
  plan                 EntityPlan @default(BASICO)
  stripeCustomerId     String?    @unique
  stripeSubscriptionId String?    @unique
  slaHours                 Json?      // { "HEALTH": 48, "MOBILITY": 72, ... }
  resolutionSlaHours       Json?      @map("resolution_sla_hours")
  slaEscalationHours       Int        @default(24) @map("sla_escalation_hours")
  autoMonthlyReportEnabled Boolean    @default(false) @map("auto_monthly_report_enabled")
  city            String?
  state           String?
  logoUrl         String?
  coverUrl        String?   // capa do perfil (proporção 3:1, 1500x500)
  website         String?
  followers       UserEntityFollower[]
  debatesHosted   Debate[]   @relation("DebatesHosted")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("entities")
}

model Party {
  id           String       @id @default(uuid())
  name         String
  abbreviation String       @unique
  number       Int          @unique
  active       Boolean      @default(true)
  logoUrl      String?
  politicians  Politician[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("parties")
}

model Politician {
  id              String   @id @default(uuid())
  createdByUserId String?  // auditoria — não determina ownership (ver OrgMembership)
  name            String   @default("") // nome completo do político
  username        String?  @unique // @ da página; único em todo o Votz (ver HandlesService)
  cpf            String?  @unique // AES-256 em app layer — chave de deduplicação
  tseId           String?  @unique // código oficial TSE (futuro: DivulgaCand)
  partyId         String
  party           Party    @relation(fields: [partyId], references: [id])
  office          String
  termStart       DateTime
  termEnd         DateTime
  electoralZone   String
  state           String
  city            String?
  avatarUrl       String?
  coverUrl        String?   // capa do perfil (proporção 3:1, 1500x500)
  website         String?
  verified             Boolean          @default(false)
  status               PoliticianStatus @default(ATIVO)
  plan                 PoliticianPlan   @default(BASICO)
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?          @unique
  mandatometer         Json?            // snapshot: { resolved, ignored, advocated }
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  propostas            Proposta[]
  debatesCreated       Debate[]             @relation("DebatesCreated")
  debateParticipations DebateParticipant[]
  followers            UserPoliticianFollower[]

  @@map("politicians")
}

model Company {
  id        String        @id @default(uuid())
  legalName String
  tradeName String
  username  String?       @unique // @ da página; único em todo o Votz (ver HandlesService)
  cnpj      String        @unique
  sector    CompanySector
  size      CompanySize
  verified             Boolean       @default(false)
  plan                 CompanyPlan   @default(STARTER)
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  votzScore            Float         @default(0)
  slaHours  Int           @default(48)
  logoUrl   String?
  coverUrl  String?   // capa do perfil (proporção 3:1, 1500x500)
  website   String?
  followers UserCompanyFollower[]
  branches  Branch[]
  adAccounts           AdAccount[]
  adHiddenBy           AdHiddenAdvertiser[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("companies")
}

model Branch {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  address      String
  city         String
  state        String
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())

  @@map("branches")
}

model Vote {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      VoteType @default(SUPPORT)
  createdAt DateTime @default(now())

  @@unique([reportId, userId, type])
  @@map("votes")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  read      Boolean          @default(false)
  reportId  String?
  report    Report?          @relation(fields: [reportId], references: [id])
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, read])
  @@index([userId, type, createdAt(sort: Desc)])
  @@map("notifications")
}

model RegistrationRequest {
  id              String                    @id @default(uuid())
  type            RegistrationRequestType
  status          RegistrationRequestStatus @default(PENDING)
  requesterId     String
  requester       User                      @relation("RegistrationRequester", fields: [requesterId], references: [id])
  payload         Json
  note            String?  @db.VarChar(500)
  claimTargetId   String?  // id do org existente a ser reivindicado (fluxo claim)
  reviewerId      String?
  reviewer        User?                     @relation("RegistrationReviewer", fields: [reviewerId], references: [id])
  reviewNote      String?
  approvedOrgId   String?  // id do org criado/reivindicado na aprovação
  approvedOrgType OrgType? // tipo do org criado/reivindicado
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@map("registration_requests")
}

// Pedido de credencial de imprensa (jornalista, veículo ou freelancer). Aprovado por moderador;
// a aprovação faz o usuário virar PRESS verificado (CSV, alerta de surto, painel de imprensa).
model PressCredential {
  id                String                @id @default(uuid())
  userId            String                @map("user_id")
  user              User                  @relation("PressCredentialUser", fields: [userId], references: [id], onDelete: Cascade)
  outletName        String                @map("outlet_name") @db.VarChar(120)
  outletType        PressOutletType       @map("outlet_type")
  jobTitle          String?               @map("job_title") @db.VarChar(80)
  website           String                @db.VarChar(300)
  newsroomEmail     String                @map("newsroom_email") @db.VarChar(200)
  coverageArea      String?               @map("coverage_area") @db.VarChar(160)
  portfolioUrls     String[]              @map("portfolio_urls")
  note              String?               @db.VarChar(500)
  // Confirmação de que a pessoa lê a caixa de e-mail da redação (link com código de uso único, guardado só como hash).
  emailConfirmedAt  DateTime?             @map("email_confirmed_at")
  emailTokenHash    String?               @unique @map("email_token_hash")
  emailTokenExpires DateTime?             @map("email_token_expires")
  status            PressCredentialStatus @default(PENDING)
  reviewerId        String?               @map("reviewer_id")
  reviewer          User?                 @relation("PressCredentialReviewer", fields: [reviewerId], references: [id])
  reviewNote        String?               @map("review_note") @db.VarChar(500)
  reviewedAt        DateTime?             @map("reviewed_at")
  plan                 PressPlan          @default(GRATUITA)
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("press_credentials")
}

// Regra do radar de imprensa (aviso por e-mail e sino). Só vale enquanto o dono continua sendo PRESS verificado.
model PressRadarRule {
  id           String              @id @default(uuid())
  userId       String              @map("user_id")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String              @db.VarChar(80)
  kind         PressRadarKind
  states       String[]            // UFs; vazio = qualquer estado
  cities       String[]            // nomes de cidade; vazio = qualquer cidade
  categories   Category[]          // vazio = qualquer tema
  minPressure  Float?              @map("min_pressure")
  stalledDays  Int?                @map("stalled_days")
  frequency    PressRadarFrequency @default(DAILY)
  active       Boolean             @default(true)
  lastDigestAt DateTime?           @map("last_digest_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  hits PressRadarHit[]

  @@index([userId, active])
  @@index([kind, active])
  @@map("press_radar_rules")
}

// Um achado do radar. `dedupKey` garante um aviso por relato (ou por surto e dia) em cada regra;
// `sentAt` nulo = ainda não foi para o e-mail (resumo diário ou próxima rodada).
model PressRadarHit {
  id        String         @id @default(uuid())
  ruleId    String         @map("rule_id")
  rule      PressRadarRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  dedupKey  String         @map("dedup_key")
  reportId  String?        @map("report_id")
  surtoId   String?        @map("surto_id")
  createdAt DateTime       @default(now()) @map("created_at")
  sentAt    DateTime?      @map("sent_at")

  @@unique([ruleId, dedupKey])
  @@index([ruleId, sentAt])
  @@map("press_radar_hits")
}

// Pedido de contato da imprensa a quem escreveu um relato público e marcou "aceito falar com a imprensa".
// É só uma camada de consentimento: não abre conversa sozinho e não revela nenhum contato do cidadão.
// A resposta (`reply`) é escrita pelo cidadão e só ele decide o que compartilhar.
model PressContactRequest {
  id            String                     @id @default(uuid())
  journalistId  String                     @map("journalist_id")
  journalist    User                       @relation("PressContactSender", fields: [journalistId], references: [id], onDelete: Cascade)
  recipientId   String                     @map("recipient_id")
  recipient     User                       @relation("PressContactRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  reportId      String                     @map("report_id")
  report        Report                     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  // Cópia do veículo na hora do pedido: o cidadão vê quem pediu mesmo que a credencial mude depois.
  outletName    String                     @map("outlet_name") @db.VarChar(120)
  outletType    PressOutletType            @map("outlet_type")
  outletWebsite String                     @map("outlet_website") @db.VarChar(300)
  message       String                     @db.VarChar(500)
  status        PressContactStatus         @default(PENDING)
  declineReason PressContactDeclineReason? @map("decline_reason")
  reply         String?                    @db.VarChar(300)
  viaVotzChat   Boolean                    @default(false) @map("via_votz_chat")
  respondedAt   DateTime?                  @map("responded_at")
  expiresAt     DateTime                   @map("expires_at")
  createdAt     DateTime                   @default(now()) @map("created_at")

  @@unique([journalistId, reportId])
  @@index([recipientId, status, createdAt])
  @@index([journalistId, createdAt])
  @@map("press_contact_requests")
}

// O cidadão bloqueou este jornalista: nenhum pedido novo chega.
model PressContactBlock {
  id           String   @id @default(uuid())
  recipientId  String   @map("recipient_id")
  recipient    User     @relation("PressContactBlocker", fields: [recipientId], references: [id], onDelete: Cascade)
  journalistId String   @map("journalist_id")
  journalist   User     @relation("PressContactBlocked", fields: [journalistId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([recipientId, journalistId])
  @@map("press_contact_blocks")
}

model Comment {
  id        String    @id @default(uuid())
  reportId  String
  report    Report    @relation(fields: [reportId], references: [id])
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  content       String
  parentId      String?
  parent        Comment?         @relation("CommentReply", fields: [parentId], references: [id])
  replies       Comment[]        @relation("CommentReply")

  mediaType     CommentMediaType @default(TEXT)
  mediaUrl      String?
  mediaKey      String?
  mediaDuration Int?
  transcript    String?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("comments")
}

// ==================== RBAC / ORG MEMBERSHIP ====================

// Role template owned by an org — permissions is a bitmask stored as a list
model OrgRole {
  id          String          @id @default(uuid())
  orgType     OrgType
  orgId       String
  name        String          // e.g. "Atendente", "Gestor"
  permissions OrgPermission[]
  isDefault   Boolean         @default(false) // pre-built role (OWNER, MANAGER, AGENT, VIEWER)
  memberships OrgMembership[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([orgType, orgId, name])
  @@map("org_roles")
}

// Ties a User to an org via a Role
model OrgMembership {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  orgType   OrgType
  orgId     String
  roleId    String
  role      OrgRole          @relation(fields: [roleId], references: [id])
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, orgType, orgId])
  @@map("org_memberships")
}

// ── Surto ────────────────────────────────────────────────────────────────────
// Alerta de problema em escala: detectado quando N+ relatos da mesma categoria
// aparecem na mesma cidade nas últimas 24 horas.
model Surto {
  id         String   @id @default(cuid())
  category   Category
  city       String
  state      String
  count      Int
  active     Boolean  @default(true)
  detectedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  reports    Report[]

  pressBriefings PressSurtoBriefing[]

  @@unique([category, city])
  @@map("surtos")
}

// Briefing de surto para a imprensa Pro. Gerado uma vez por surto (e refeito depois de algumas horas), não por pessoa:
// o custo da IA depende do número de surtos, não de quantos jornalistas olham. `stats` sai do banco; `content` é o texto
// da IA, que nunca traz número e só é guardado se passar na checagem (senão fica nulo e `aiGenerated` é falso).
model PressSurtoBriefing {
  id          String   @id @default(uuid())
  surtoId     String   @map("surto_id")
  surto       Surto    @relation(fields: [surtoId], references: [id], onDelete: Cascade)
  aiGenerated Boolean  @map("ai_generated")
  model       String?  @db.VarChar(80)
  content     Json?
  stats       Json
  references  Json
  generatedAt DateTime @default(now()) @map("generated_at")

  @@index([surtoId, generatedAt])
  @@map("press_surto_briefings")
}

// Politician or entity explicitly following a report for notifications/visibility
model ReportFollower {
  id        String            @id @default(uuid())
  reportId  String
  report    Report            @relation(fields: [reportId], references: [id])
  actorType FollowerActorType
  actorId   String            // politician.id or entity.id
  createdAt DateTime          @default(now())

  @@unique([reportId, actorType, actorId])
  @@index([actorType, actorId])
  @@map("report_followers")
}

// API keys — used by the public API (section 3.6 / 10)
model ApiKey {
  id         String     @id @default(uuid())
  name       String
  keyHash    String     @unique
  prefix     String                     // first 12 chars for safe display
  tier       ApiKeyTier @default(FREE)
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
  @@map("api_keys")
}

// Pending invite — resolved when the invitee clicks the link
model MemberInvite {
  id          String    @id @default(uuid())
  orgType     OrgType
  orgId       String
  email       String
  roleId      String
  token       String    @unique @default(uuid())
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@map("member_invites")
}

// ==================== PROPOSTAS ====================

model Proposta {
  id          String         @id @default(uuid())
  titulo      String
  descricao   String
  status      PropostaStatus @default(DRAFT)
  categorias  Category[]
  linkExterno String?

  politicoId  String
  politico    Politician     @relation(fields: [politicoId], references: [id])

  timeline         PropostaTimeline[]
  votos            PropostaVoto[]
  mentionedInPosts Post[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("propostas")
}

model PropostaTimeline {
  id         String            @id @default(uuid())
  propostaId String
  proposta   Proposta          @relation(fields: [propostaId], references: [id])
  tipo       PropostaEventType
  conteudo   String
  autorId    String?
  autor      User?             @relation(fields: [autorId], references: [id])
  metadata   Json?
  createdAt  DateTime          @default(now())

  @@map("proposta_timeline")
}

model PropostaVoto {
  id         String   @id @default(uuid())
  propostaId String
  proposta   Proposta @relation(fields: [propostaId], references: [id])
  usuarioId  String
  usuario    User     @relation(fields: [usuarioId], references: [id])
  apoio      Boolean  // true = apoia, false = rejeita
  createdAt  DateTime @default(now())

  @@unique([propostaId, usuarioId])
  @@map("proposta_votos")
}

// ==================== DEBATES ====================

model Debate {
  id               String       @id @default(cuid())
  title            String
  description      String?
  scheduledFor     DateTime
  status           DebateStatus @default(SCHEDULED)
  livekitRoomName  String?      @unique
  hlsUrl           String?
  recordingUrl     String?
  egressId         String?
  viewerCount      Int          @default(0)
  chatCooldownSecs Int          @default(5)

  // Transmissão: debates antigos usam LiveKit; os novos nascem com YOUTUBE (live incorporada).
  // O vídeo é externo: a Memória do Votz guarda só o registro do debate, não o vídeo.
  streamProvider      StreamProvider @default(LIVEKIT)
  youtubeVideoId      String?        @map("youtube_video_id")
  youtubeChannelId    String?        @map("youtube_channel_id")
  youtubeChannelTitle String?        @map("youtube_channel_title")

  // Anfitrião: exatamente um dos dois (regra no service). Político por creatorId, entidade por hostEntityId.
  creatorId        String?
  creator          Politician?  @relation("DebatesCreated", fields: [creatorId], references: [id], onDelete: Restrict)
  hostEntityId     String?      @map("host_entity_id")
  hostEntity       Entity?      @relation("DebatesHosted", fields: [hostEntityId], references: [id], onDelete: Restrict)

  participants     DebateParticipant[]
  questions        DebateQuestion[]
  reactions        DebateReaction[]
  messages         DebateMessage[]
  polls            DebatePoll[]
  mentionedInPosts Post[]
  topics           DebateTopic[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("debates")
}

model DebateParticipant {
  id           String          @id @default(cuid())
  debateId     String
  politicianId String
  role         ParticipantRole @default(DEBATER)
  inviteStatus InviteStatus    @default(PENDING)
  createdAt    DateTime        @default(now())

  // Live opcional do próprio debatedor ("Assistir pelo canal de X"). Só de canal verificado dele.
  youtubeVideoId      String? @map("youtube_video_id")
  youtubeChannelTitle String? @map("youtube_channel_title")

  debate       Debate     @relation(fields: [debateId], references: [id], onDelete: Cascade)
  politician   Politician @relation(fields: [politicianId], references: [id])

  @@unique([debateId, politicianId])
  @@map("debate_participants")
}

// Canal do YouTube de uma organização (político/equipe ou entidade). Só canal verificado
// (código colado na descrição do canal) pode transmitir ou ser anexado a um debate.
// Organização polimórfica, no mesmo padrão de OrgMembership (sem FK).
model YoutubeChannel {
  id               String    @id @default(cuid())
  orgType          OrgType   @map("org_type")
  orgId            String    @map("org_id")
  channelId        String    @unique @map("channel_id")
  title            String
  verificationCode String    @map("verification_code")
  verifiedAt       DateTime? @map("verified_at")
  createdByUserId  String?   @map("created_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([orgType, orgId])
  @@map("youtube_channels")
}

model DebateQuestion {
  id        String   @id @default(cuid())
  debateId  String
  authorId  String
  text      String   @db.VarChar(500)
  upvotes   Int      @default(0)
  answered  Boolean  @default(false)
  createdAt DateTime @default(now())

  debate    Debate @relation(fields: [debateId], references: [id], onDelete: Cascade)
  author    User   @relation(fields: [authorId], references: [id])

  @@map("debate_questions")
}

model DebateReaction {
  id        String       @id @default(cuid())
  debateId  String
  type      ReactionType
  createdAt DateTime     @default(now())

  debate    Debate @relation(fields: [debateId], references: [id], onDelete: Cascade)

  @@map("debate_reactions")
}

model DebateMessage {
  id        String   @id @default(cuid())
  debateId  String
  authorId  String
  text      String   @db.VarChar(500)
  createdAt DateTime @default(now())

  debate    Debate @relation(fields: [debateId], references: [id], onDelete: Cascade)
  author    User   @relation(fields: [authorId], references: [id])

  @@map("debate_messages")
}

model DebatePoll {
  id        String             @id @default(cuid())
  debateId  String
  question  String
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())

  debate    Debate             @relation(fields: [debateId], references: [id], onDelete: Cascade)
  options          DebatePollOption[]
