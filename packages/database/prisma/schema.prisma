  post    Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  topic   CivicTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([postId, topicId])
  @@index([topicId])
  @@map("post_topics")
}

model ReportTopic {
  reportId String     @map("report_id")
  topicId  String     @map("topic_id")
  report   Report     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  topic    CivicTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([reportId, topicId])
  @@index([topicId])
  @@map("report_topics")
}

model DebateTopic {
  debateId String     @map("debate_id")
  topicId  String     @map("topic_id")
  debate   Debate     @relation(fields: [debateId], references: [id], onDelete: Cascade)
  topic    CivicTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([debateId, topicId])
  @@index([topicId])
  @@map("debate_topics")
}

model UserFollow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([followerId, followingId])
  @@map("user_follows")
}

model UserEntityFollower {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  entityId  String   @map("entity_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, entityId])
  @@map("user_entity_followers")
}

model UserCompanyFollower {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  companyId String   @map("company_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("user_company_followers")
}

model UserTopicFollower {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  topicId   String     @map("topic_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     CivicTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([userId, topicId])
  @@map("user_topic_followers")
}

enum SuggestionCategory {
  FEATURE
  IMPROVEMENT
  BUG
  UX
  OTHER
}

enum SuggestionStatus {
  OPEN
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  COMPLETED
  DECLINED
}

model PlatformSuggestion {
  id           String             @id @default(uuid())
  authorId     String             @map("author_id")
  author       User               @relation("SuggestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title        String             @db.VarChar(150)
  description  String             @db.VarChar(2000)
  category     SuggestionCategory @default(IMPROVEMENT)
  status       SuggestionStatus   @default(OPEN)
  adminNote    String?            @map("admin_note") @db.VarChar(1000)
  reviewedById String?            @map("reviewed_by_id")
  reviewedAt   DateTime?          @map("reviewed_at")
  votesCount   Int                @default(0) @map("votes_count")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  votes        PlatformSuggestionVote[]

  @@index([status, votesCount])
  @@index([createdAt])
  @@map("platform_suggestions")
}

model PlatformSuggestionVote {
  id           String             @id @default(uuid())
  suggestionId String             @map("suggestion_id")
  userId       String             @map("user_id")
  suggestion   PlatformSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now()) @map("created_at")

  @@unique([suggestionId, userId])
  @@map("platform_suggestion_votes")
}

// ── Mensagens para páginas (político, entidade, empresa) ─────────────────────
// Caixa de entrada da página: um cidadão fala com a EQUIPE, não com uma pessoa.
// Texto cifrado no banco (AES-256-GCM, chave do servidor), NÃO é ponta a ponta:
// a equipe com READ_MESSAGES lê, com REPLY_MESSAGES responde. Decisão do dono (20/11/2026).
model PageConversation {
  id            String                 @id @default(uuid())
  orgType       OrgType                @map("org_type")
  orgId         String                 @map("org_id")
  citizenId     String                 @map("citizen_id")
  citizen       User                   @relation("PageConversationCitizen", fields: [citizenId], references: [id], onDelete: Cascade)
  status        PageConversationStatus @default(OPEN)
  /// Quem começou. Conversa iniciada pela página só segue depois que o cidadão aceita.
  startedBy       PageMessageSender      @default(CITIZEN) @map("started_by")
  citizenAccepted Boolean                @default(true) @map("citizen_accepted")
  lastMessageAt DateTime               @default(now()) @map("last_message_at")
  lastSender    PageMessageSender      @default(CITIZEN) @map("last_sender")
  staffUnread   Int                    @default(0) @map("staff_unread")
  citizenUnread Int                    @default(0) @map("citizen_unread")
  createdAt     DateTime               @default(now()) @map("created_at")
  messages      PageMessage[]
  reads         PageConversationRead[]
  attachments   PageAttachment[]

  @@unique([orgType, orgId, citizenId])
  @@index([orgType, orgId, status, lastMessageAt])
  @@index([citizenId, lastMessageAt])
  @@map("page_conversations")
}

model PageMessage {
  id             String            @id @default(uuid())
  conversationId String            @map("conversation_id")
  conversation   PageConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String            @map("sender_id")
  sender         User              @relation("PageMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderKind     PageMessageSender @map("sender_kind")
  bodyEnc        String            @map("body_enc")
  replyToId      String?           @map("reply_to_id")
  replyTo        PageMessage?      @relation("PageMessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        PageMessage[]     @relation("PageMessageReply")
  attachment     PageAttachment?
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("page_messages")
}

// Anexos das mensagens com páginas (foto, vídeo, áudio, arquivo). Guardados cifrados no bucket privado.
model PageAttachment {
  id             String           @id @default(uuid())
  conversationId String           @map("conversation_id")
  conversation   PageConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String           @unique @map("message_id")
  message        PageMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  objectKey      String           @unique @map("object_key")
  kind           String
  mimeType       String           @map("mime_type")
  nameEnc        String           @map("name_enc")
  sizeBytes      Int              @map("size_bytes")
  width          Int?
  height         Int?
  durationMs     Int?             @map("duration_ms")
  thumbnail      String?
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("page_attachments")
}

// Auditoria: quem da equipe abriu cada conversa e quando foi a última vez.
model PageConversationRead {
  id             String           @id @default(uuid())
  conversationId String           @map("conversation_id")
  conversation   PageConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String           @map("user_id")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstReadAt    DateTime         @default(now()) @map("first_read_at")
  lastReadAt     DateTime         @default(now()) @map("last_read_at")

  @@unique([conversationId, userId])
  @@map("page_conversation_reads")
}

// ─── Padrão de fotos e vídeos (publicações e, depois, criativos de anúncio) ───────────────────────
// docs/dev/padrao-de-midia-plano-2026-11-21.md. Relatos continuam em `report_media` (sem recorte: foto é prova).

enum MediaAssetPurpose {
  POST
  AD_CREATIVE
}

enum MediaAssetKind {
  IMAGE
  VIDEO
  GIF
}

// UPLOADING: envio direto ao bucket ainda não confirmado. UPLOADED: arquivo recebido, ainda sem publicação.
// PROCESSING: vídeo sendo recortado e convertido. READY: pronto para mostrar. FAILED: não deu para processar.
enum MediaAssetStatus {
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum MediaFormat {
  SQUARE
  PORTRAIT
  LANDSCAPE
}

model MediaAsset {
  id              String            @id @default(uuid())
  uploaderId      String            @map("uploader_id")
  purpose         MediaAssetPurpose @default(POST)
  kind            MediaAssetKind
  status          MediaAssetStatus
  // Original privado (pasta media-src/, sem metadados da câmera na foto). Nulo nos arquivos antigos e depois de
  // o vídeo ficar pronto (o original é apagado para não pagar armazenamento duas vezes).
  sourceKey       String?           @unique @map("source_key")
  sourceMime      String            @map("source_mime")
  sourceSizeBytes Int               @map("source_size_bytes")
  // Tamanho do original como a pessoa vê (já girado).
  sourceWidth     Int?              @map("source_width")
  sourceHeight    Int?              @map("source_height")
  durationMs      Int?              @map("duration_ms")
  // Moldura e recorte escolhidos ao publicar (frações de 0 a 1 do original). Nulos em GIF e nos antigos.
  format          MediaFormat?
  cropX           Float?            @map("crop_x")
  cropY           Float?            @map("crop_y")
  cropW           Float?            @map("crop_w")
  cropH           Float?            @map("crop_h")
  // Arquivos públicos gerados: versão cheia (`key`), do feed, miniatura e capa do vídeo.
  key             String?           @unique
  feedKey         String?           @map("feed_key")
  thumbKey        String?           @map("thumb_key")
  posterKey       String?           @map("poster_key")
  width           Int?
  height          Int?
  sizeBytes       Int?              @map("size_bytes")
  // Publicação de antes do padrão: aparece inteira na moldura mais próxima, com fundo desfocado.
  legacy          Boolean           @default(false)
  failureReason   String?           @map("failure_reason")
  postId          String?           @map("post_id")
  post            Post?             @relation(fields: [postId], references: [id], onDelete: Cascade)
  position        Int?
  // Criativo de anúncio dono do arquivo (até 5 fotos, ou um vídeo, por criativo). Nunca junto com `postId` (o banco barra).
  adCreativeId    String?           @map("ad_creative_id")
  adCreative      AdCreative?       @relation(fields: [adCreativeId], references: [id], onDelete: Cascade)
  attachedAt      DateTime?         @map("attached_at")
  processedAt     DateTime?         @map("processed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([postId, position])
  @@index([adCreativeId, position])
  @@index([uploaderId, createdAt])
  @@index([status, createdAt])
  @@index([attachedAt, createdAt])
  @@map("media_assets")
}

// Gênero informado pela pessoa no cadastro (opcional). Mesma lista de USER_GENDERS em @votz/shared-types.
enum UserGender {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED
}

// Preferências de anúncios da pessoa (plano de anúncios, seção 3.4). A personalização só vale com
// `personalization_consent = true` (opt-in: padrão desligado). `interests` guarda ids de AD_INTERESTS.
model AdUserPreference {
  userId                 String    @id @map("user_id")
  personalizationConsent Boolean   @default(false) @map("personalization_consent")
  consentAt              DateTime? @map("consent_at")
  consentVersion         String?   @map("consent_version")
  interests              String[]  @default([])
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ad_user_preferences")
}

// ── Anúncios: plataforma do anunciante (plano de anúncios, Etapa 1) ─────────
// Conta de anúncios → campanha → conjunto (público e orçamento) → anúncio (usa um criativo).

enum AdObjective {
  AWARENESS // reconhecimento: cobrado por mil exibições
  TRAFFIC // tráfego: cobrado por clique
  CONVERSIONS // conversões: cobrado por mil exibições, otimizado para conversão
  MESSAGES // mensagens: cobrado por clique; o botão leva a falar com a equipe (chat da página no Votz ou WhatsApp)
}

// Para onde o botão do anúncio leva. URL: site do anunciante. PAGE_MESSAGE: chat da página da empresa no Votz.
// WHATSAPP: conversa no WhatsApp (ainda não aberto a anunciantes).
enum AdDestinationKind {
  URL
  PAGE_MESSAGE
  WHATSAPP
}

enum AdStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AdReviewStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

model AdAccount {
  id           String       @id @default(uuid())
  companyId    String       @map("company_id")
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  currency     String       @default("BRL")
  timezone     String       @default("America/Sao_Paulo")
  // Saldo pré-pago em centavos. Só muda pelo livro-caixa (AdLedgerEntry), na mesma transação do lançamento.
  balanceCents Int          @default(0) @map("balance_cents")
  // Gasto que ainda não completou um centavo (milésimos de centavo). Vira lançamento SPEND quando passa de 1.000.
  pendingSpendMillicents Int @default(0) @map("pending_spend_millicents")
  // Controle dos avisos de saldo. Aviso de saldo baixo: guarda quando foi mandado e zera quando o saldo se recupera.
  // Aviso de pausa: `pausedForBalanceAt` é quando as campanhas pausaram por falta de saldo; o aviso vale uma vez por pausa.
  lowBalanceAlertedAt DateTime? @map("low_balance_alerted_at")
  pausedForBalanceAt  DateTime? @map("paused_for_balance_at")
  pausedAlertSentAt   DateTime? @map("paused_alert_sent_at")
  createdById  String       @map("created_by_id")
  campaigns    AdCampaign[]
  creatives    AdCreative[]
  topUps       AdTopUp[]
  ledger       AdLedgerEntry[]
  refunds      AdRefund[]
  autoTopUp    AdAutoTopUp?
  invoices     AdInvoice[]
  conversionKeys AdConversionKey[]
  conversions  AdConversion[]
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("ad_accounts")
}

model AdCampaign {
  id        String      @id @default(uuid())
  accountId String      @map("account_id")
  account   AdAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  objective AdObjective
  status    AdStatus    @default(DRAFT)
  adSets    AdSet[]
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([accountId, status])
  @@map("ad_campaigns")
}

// Público e orçamento. Só sinais permitidos: região, interesses de AD_INTERESTS, faixas de idade, gênero.
model AdSet {
  id                String       @id @default(uuid())
  campaignId        String       @map("campaign_id")
  campaign          AdCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name              String
  status            AdStatus     @default(DRAFT)
  dailyBudgetCents  Int          @map("daily_budget_cents")
  // Lance máximo em centavos (por mil exibições ou por clique, conforme o objetivo). Nulo: o Votz decide.
  bidCapCents       Int?         @map("bid_cap_cents")
  startAt           DateTime     @map("start_at")
  endAt             DateTime?    @map("end_at")
  states            String[]     @default([])
  cities            String[]     @default([])
  interests         String[]     @default([])
  ageBands          String[]     @default([]) @map("age_bands")
  genders           UserGender[] @default([])
  // Público automático: a IA encontra o público (só objetivo e região contam).
  automaticAudience Boolean      @default(false) @map("automatic_audience")
  ads               Ad[]
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@index([campaignId])
  @@map("ad_sets")
}

model AdCreative {
  id             String    @id @default(uuid())
  accountId      String    @map("account_id")
  account        AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  headline       String
  body           String
  ctaLabel       String    @map("cta_label")
  destinationUrl String    @map("destination_url")
  // Tipo do destino. Em PAGE_MESSAGE e WHATSAPP o servidor monta destinationUrl (o anunciante não digita link).
  destinationKind AdDestinationKind @default(URL) @map("destination_kind")
  // Só em WHATSAPP: número (só dígitos, com 55) e mensagem inicial. destinationUrl é o wa.me montado a partir deles.
  whatsappPhone  String?   @map("whatsapp_phone")
  whatsappText   String?   @map("whatsapp_text")
  // Fotos ou vídeo do anúncio (padrão de mídia: 1:1, 4:5 ou 16:9), na ordem de `position`. Até 5 fotos (carrossel) ou um
  // vídeo sozinho. Sem mídia, o anúncio é só texto.
  media          MediaAsset[]
  ads            Ad[]
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([accountId])
  @@map("ad_creatives")
}

model Ad {
  id           String         @id @default(uuid())
  adSetId      String         @map("ad_set_id")
  adSet        AdSet          @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  creativeId   String         @map("creative_id")
  creative     AdCreative     @relation(fields: [creativeId], references: [id], onDelete: Restrict)
  name         String
  status       AdStatus       @default(DRAFT)
  reviewStatus AdReviewStatus @default(NOT_SUBMITTED) @map("review_status")
  reviewNote   String?        @map("review_note")
  submittedAt  DateTime?      @map("submitted_at")
  reviewedAt   DateTime?      @map("reviewed_at")
  reviews      AdReview[]
  aiAnalyses   AdAiAnalysis[]
  impressions  AdImpression[]
  events       AdEvent[]
  dailyStats   AdDailyStat[]
  fraudFlags   AdFraudFlag[]
  landingChecks AdLandingCheck[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([adSetId])
  @@index([reviewStatus, submittedAt])
  @@map("ads")
}

// Leitura do anúncio pela IA (Gemini) antes da fila humana. É um parecer para o moderador; só vira decisão
// (AdReview com source AI) quando ADS_AI_AUTO_APPROVE está ligado e todas as condições de segurança passam.
model AdAiAnalysis {
  id           String   @id @default(uuid())
  adId         String   @map("ad_id")
  ad           Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  // Categoria de interesse sugerida (lista fechada de AD_INTERESTS) ou null.
  category     String?
  // Categoria restrita detectada (saúde, educação, financeiro, imóveis, bebida) ou null.
  restricted   String?
  // [{ id: categoria proibida, confidence: 0..1 }], inclui os achados da checagem por palavras.
  violations   Json
  sensitive    Boolean
  confidence   Float
  explanation  String
  model        String
  // A IA estava apta a aprovar sozinha (sem problema e confiança alta) e o modo automático estava ligado.
  autoApproved Boolean  @default(false) @map("auto_approved")
  // O que a IA leu da foto ou do vídeo: IMAGE (a foto), VIDEO_FRAMES_AUDIO (quadros do vídeo e o som),
  // VIDEO_FRAMES (quadros, mas o som não deu para ouvir), VIDEO_SILENT (quadros; o vídeo não tem som),
  // UNREADABLE (tinha mídia, mas não deu para ler) ou null (anúncio só de texto).
  mediaScope   String?  @map("media_scope")
  // O que se vê na mídia, em uma ou duas frases, e o texto escrito nela (para o moderador).
  mediaSummary String?  @map("media_summary")
  mediaText    String?  @map("media_text")
  // O que a IA ouviu no áudio do vídeo (falado ou cantado), para o moderador.
  audioText    String?  @map("audio_text")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([adId, createdAt])
  @@map("ad_ai_analyses")
}

// ── Anúncios: revisão e faturamento (plano de anúncios, Etapa 1, parte 2) ───

enum AdReviewSource {
  HUMAN // fila da moderação
  AI // revisão automática (vem depois)
}

// Cada decisão sobre um anúncio. Nunca é editada nem apagada: é o histórico para recurso e auditoria.
model AdReview {
  id               String         @id @default(uuid())
  adId             String         @map("ad_id")
  ad               Ad             @relation(fields: [adId], references: [id], onDelete: Cascade)
  decision         AdReviewStatus // APPROVED ou REJECTED
  source           AdReviewSource @default(HUMAN)
  reviewerId       String?        @map("reviewer_id")
  reviewer         User?          @relation("AdReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reason           String?
  // Como o anúncio estava no momento da decisão (texto, botão e link).
  creativeSnapshot Json           @map("creative_snapshot")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([adId, createdAt])
  @@index([reviewerId])
  @@map("ad_reviews")
}

enum AdTopUpMethod {
  PIX
  BOLETO
  CARD
}

enum AdPaymentProvider {
  TEST // modo de teste local: não chama serviço externo
  ASAAS // Pix e boleto
  STRIPE // cartão
}

enum AdTopUpStatus {
  PENDING
  PAID
  EXPIRED
  CANCELED
}

// Pedido de recarga de saldo. Só vira dinheiro na conta quando passa de PENDING para PAID (com lançamento no livro-caixa).
model AdTopUp {
  id          String            @id @default(uuid())
  adAccountId String            @map("ad_account_id")
  adAccount   AdAccount         @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  amountCents Int               @map("amount_cents")
  method      AdTopUpMethod
  provider    AdPaymentProvider
  status      AdTopUpStatus     @default(PENDING)
  // Identificador da cobrança no provedor e o que a pessoa usa para pagar (Pix copia e cola, linha do boleto, link).
  externalId  String?           @map("external_id")
  paymentCode String?           @map("payment_code")
  checkoutUrl String?           @map("checkout_url")
  expiresAt   DateTime          @map("expires_at")
  paidAt      DateTime?         @map("paid_at")
  createdById String            @map("created_by_id")
  // Recarga feita sozinha pela recarga automática (e não por uma pessoa pedindo na tela).
  auto        Boolean           @default(false)
  ledger      AdLedgerEntry[]
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@unique([provider, externalId])
  @@index([adAccountId, createdAt])
  @@index([status, expiresAt])
  @@map("ad_top_ups")
}

// Contas do livro-caixa (partidas dobradas). CUSTOMER_BALANCE é passivo: o saldo do anunciante é a soma dos créditos menos os débitos.
enum AdLedgerAccount {
  CUSTOMER_BALANCE // saldo que o Votz deve ao anunciante
  PAYMENTS_RECEIVED // dinheiro recebido dos provedores (Asaas, Stripe, teste)
  AD_REVENUE // receita de anúncios (gasto das campanhas)
  PROMO_FUND // crédito dado pelo Votz (ajuste manual)
  REFUNDS_PAYABLE // devoluções pedidas e ainda não pagas: o que o Votz deve devolver ao anunciante
}

enum AdLedgerSide {
  DEBIT
  CREDIT
}

enum AdLedgerEntryType {
  TOPUP
  SPEND
  REFUND
  ADJUSTMENT
}

// Livro-caixa de dupla entrada. Toda transação (transactionId) tem lançamentos cujos débitos somam igual aos créditos.
// Nunca é editado nem apagado: correção é um lançamento novo, no sentido contrário.
model AdLedgerEntry {
  id            String            @id @default(uuid())
  adAccountId   String            @map("ad_account_id")
  adAccount     AdAccount         @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  transactionId String            @map("transaction_id")
  ledger        AdLedgerAccount
  side          AdLedgerSide
  amountCents   Int               @map("amount_cents")
  type          AdLedgerEntryType
  description   String
  topUpId       String?           @map("top_up_id")
  topUp         AdTopUp?          @relation(fields: [topUpId], references: [id], onDelete: SetNull)
  refundId      String?           @map("refund_id")
  refund        AdRefund?         @relation(fields: [refundId], references: [id], onDelete: SetNull)
  createdById   String?           @map("created_by_id")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([adAccountId, createdAt])
  @@index([transactionId])
  @@index([topUpId])
  @@index([refundId])
  @@map("ad_ledger_entries")
}

enum AdRefundStatus {
  REQUESTED // pedida: o valor já saiu do saldo (fica em "devoluções a pagar") e espera o Votz devolver o dinheiro
  PAID // dinheiro devolvido
  REJECTED // recusada pelo Votz: o valor volta para o saldo
  CANCELED // cancelada pelo anunciante antes de ser paga: o valor volta para o saldo
}

// Pedido de devolução do saldo que sobrou. O valor sai do saldo na hora do pedido, para não ser gasto enquanto espera.
model AdRefund {
  id             String          @id @default(uuid())
  adAccountId    String          @map("ad_account_id")
  adAccount      AdAccount       @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  amountCents    Int             @map("amount_cents")
  status         AdRefundStatus  @default(REQUESTED)
  reason         String?
  requestedById  String          @map("requested_by_id")
  resolvedById   String?         @map("resolved_by_id")
  resolutionNote String?         @map("resolution_note")
  // Identificador da devolução no banco ou provedor, quando o Votz paga.
  externalId     String?         @map("external_id")
  requestedAt    DateTime        @default(now()) @map("requested_at")
  resolvedAt     DateTime?       @map("resolved_at")
  ledger         AdLedgerEntry[]

  @@index([adAccountId, requestedAt])
  @@index([status, requestedAt])
  @@map("ad_refunds")
}

// Recarga automática: quando o saldo cai abaixo do piso, o Votz cobra o cartão salvo (nunca o número: só uma referência do provedor).
model AdAutoTopUp {
  adAccountId         String            @id @map("ad_account_id")
  adAccount           AdAccount         @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  enabled             Boolean           @default(false)
  // Quando o saldo disponível ficar abaixo disto, recarrega `amountCents`.
  thresholdCents      Int               @map("threshold_cents")
  amountCents         Int               @map("amount_cents")
  // Teto de recargas automáticas por mês (centavos): passou disso, para até o mês seguinte.
  monthlyLimitCents   Int               @map("monthly_limit_cents")
  provider            AdPaymentProvider
  // Referência do cartão no provedor. Nunca o número do cartão.
  paymentMethodRef    String?           @map("payment_method_ref")
  consentAt           DateTime?         @map("consent_at")
  consentById         String?           @map("consent_by_id")
  lastTriggeredAt     DateTime?         @map("last_triggered_at")
  consecutiveFailures Int               @default(0) @map("consecutive_failures")
  // Por que foi desligada sozinha (falhas seguidas, teto do mês). Vazio se está tudo bem.
  stoppedReason       String?           @map("stopped_reason")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@map("ad_auto_top_ups")
}

enum AdInvoiceStatus {
  PENDING // criada, ainda não emitida
  ISSUED // nota emitida
  FAILED // a emissão falhou depois de várias tentativas: precisa de ajuda humana
  CANCELED
}

// Nota fiscal de serviço de um mês de gasto com anúncios. O valor sai do livro-caixa (soma do gasto do mês), então confere sempre.
model AdInvoice {
  id          String          @id @default(uuid())
  adAccountId String          @map("ad_account_id")
  adAccount   AdAccount       @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  // Mês de competência: primeiro e último dia (fuso de São Paulo).
  periodStart DateTime        @map("period_start") @db.Date
  periodEnd   DateTime        @map("period_end") @db.Date
  amountCents Int             @map("amount_cents")
  status      AdInvoiceStatus @default(PENDING)
  // Dados do tomador no momento da emissão (a empresa pode mudar o cadastro depois).
  takerName   String          @map("taker_name")
  takerCnpj   String          @map("taker_cnpj")
  provider    String?
  externalId  String?         @map("external_id")
  number      String?
  pdfUrl      String?         @map("pdf_url")
  xmlUrl      String?         @map("xml_url")
  attempts    Int             @default(0)
  lastError   String?         @map("last_error")
  issuedAt    DateTime?       @map("issued_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@unique([adAccountId, periodStart])
  @@index([status, createdAt])
  @@map("ad_invoices")
}

// ── Anúncios: entrega, eventos e medição (plano de anúncios, Etapa 2) ───────

enum AdChargeOn {
  VIEWABLE_IMPRESSION // reconhecimento e conversões: por exibição visível
  CLICK // tráfego: por clique
}

enum AdEventStatus {
  ACCEPTED
  INVALID // não é cobrado; o motivo fica em `reason`
}

// Uma vez que o Votz entrega um anúncio a uma pessoa. O preço (em milésimos de centavo) é fixado aqui, na entrega.
// Os carimbos viewable_at, clicked_at e hidden_at só mudam de nulo para data uma vez: é isso que impede cobrar duas vezes.
model AdImpression {
  id               String     @id @default(uuid())
  adId             String     @map("ad_id")
  ad               Ad         @relation(fields: [adId], references: [id], onDelete: Cascade)
  userId           String     @map("user_id")
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  surface          String
  position         Int        @default(0)
  chargeOn         AdChargeOn @map("charge_on")
  // Quanto custa UMA unidade cobrada (uma exibição visível ou um clique), em milésimos de centavo.
  chargeMillicents Int        @map("charge_millicents")
  // Nulos nas entregas anteriores à reserva. A cobrança zera a validade e registra
  // o valor efetivo, inclusive zero quando o limite já foi atingido.
  spendAccountId   String?   @map("spend_account_id")
  spendAdSetId     String?   @map("spend_ad_set_id")
  spendDay         DateTime? @db.Date @map("spend_day")
  spendReservedUntil DateTime? @map("spend_reserved_until")
  billedMillicents Int?      @map("billed_millicents")
  servedAt         DateTime   @default(now()) @map("served_at")
  viewableAt       DateTime?  @map("viewable_at")
  clickedAt        DateTime?  @map("clicked_at")
  hiddenAt         DateTime?  @map("hidden_at")
  // Quando a pessoa denunciou este anúncio (carimbo uma vez só, como esconder).
  reportedAt       DateTime?  @map("reported_at")
  // Teste A/B da entrega: "nome-do-experimento:braço" em que a pessoa estava quando esta exibição foi escolhida.
  // Nulo fora de experimento. Só serve para comparar braços no relatório.
  experiment       String?
  // Identificador do clique (`votz_click_id`): sorteado na entrega, vai no link do botão e para o anunciante.
  // Não é a exibição nem a pessoa: o anunciante não consegue chegar em nenhuma das duas por ele.
  clickToken       String?    @unique @map("click_token")
  // Primeira vez que alguém abriu o link do botão (`/c/<id>`): é de onde conta a janela de atribuição.
  landedAt         DateTime?  @map("landed_at")
  events           AdEvent[]
  conversions      AdConversion[]

  @@index([userId, adId, servedAt])
  @@index([adId, servedAt])
  @@index([experiment, servedAt])
  @@index([spendAccountId, spendReservedUntil], map: "ad_impressions_spend_account_reservation_idx")
  @@index([spendAdSetId, spendDay, spendReservedUntil], map: "ad_impressions_spend_ad_set_reservation_idx")
  @@map("ad_impressions")
}

// Cada evento que o aparelho mandou. `event_id` único evita contar duas vezes. Evento inválido fica guardado
// (para medir tráfego inválido), mas nunca é cobrado.
model AdEvent {
  id           String        @id @default(uuid())
  eventId      String        @unique @map("event_id")
  impressionId String        @map("impression_id")
  impression   AdImpression  @relation(fields: [impressionId], references: [id], onDelete: Cascade)
  adId         String        @map("ad_id")
  ad           Ad            @relation(fields: [adId], references: [id], onDelete: Cascade)
  type         String
  status       AdEventStatus
  reason       String?
  visibleMs    Int?          @map("visible_ms")
  occurredAt   DateTime      @map("occurred_at")
  receivedAt   DateTime      @default(now()) @map("received_at")

  @@index([impressionId])
  @@index([adId, receivedAt])
  @@map("ad_events")
}

// Contagem por anúncio e dia (fuso de São Paulo). Base dos relatórios. Gasto em milésimos de centavo.
model AdDailyStat {
  id                  String   @id @default(uuid())
  adId                String   @map("ad_id")
  ad                  Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  adSetId             String   @map("ad_set_id")
  day                 DateTime @db.Date
  impressions         Int      @default(0)
  viewableImpressions Int      @default(0) @map("viewable_impressions")
  clicks              Int      @default(0)
  hides               Int      @default(0)
  // Denúncias contadas: uma por pessoa e anúncio no dia, só de quem viu o anúncio. Pesam mais que "esconder" no leilão.
  reports             Int      @default(0)
  invalidEvents       Int      @default(0) @map("invalid_events")
  spendMillicents     Int      @default(0) @map("spend_millicents")
  // Conversões contadas pelo anunciante (API de conversões), no dia em que aconteceram.
  conversions         Int      @default(0)
  conversionValueCents BigInt  @default(0) @map("conversion_value_cents")
  // Conversas iniciadas: a pessoa tocou no anúncio de mensagens e escreveu para a página da empresa (uma por clique).
  // Contagem à parte de `conversions`: não vem do anunciante e não tem valor.
  messageConversations Int     @default(0) @map("message_conversations")

  @@unique([adId, day])
  @@index([adSetId, day])
  @@map("ad_daily_stats")
}

// Modo sombra da entrega: o que um braço de teste TERIA escolhido, enquanto quem foi servido foi o controle. Ninguém vê o
// anúncio da sombra. Sem id de pessoa e sem chave estrangeira: só serve para comparar os dois caminhos.
model AdShadowDecision {
  id               String   @id @default(uuid())
  experiment       String
  arm              String
  servedAdId       String?  @map("served_ad_id")
  shadowAdId       String?  @map("shadow_ad_id")
  // Os dois escolheram o mesmo anúncio (ou os dois nenhum)?
  agreed           Boolean
  // Valor por mil exibições (eCPM, em centavos) do anúncio escolhido por cada caminho. Preço de clique e de mil exibições
  // têm unidades diferentes; só o eCPM permite comparar.
  servedEcpmCents  Float?   @map("served_ecpm_cents")
  shadowEcpmCents  Float?   @map("shadow_ecpm_cents")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([experiment, arm, createdAt])
  @@map("ad_shadow_decisions")
}

// Chave que o anunciante usa para mandar conversões (`POST /ads/conversions`). Só o hash (SHA-256) fica guardado;
// a chave inteira aparece uma vez, na criação. Vale para uma conta de anúncios.
model AdConversionKey {
  id          String    @id @default(uuid())
  accountId   String    @map("account_id")
  account     AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  prefix      String
  keyHash     String    @unique @map("key_hash")
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  conversions AdConversion[]

  @@index([accountId])
  @@map("ad_conversion_keys")
}

// Uma conversão (compra, contato, cadastro) que o anunciante ligou a um clique. Sem dado pessoal. `dedupe_key` é do
// anunciante e vale por conta: mandar de novo a mesma não conta duas vezes.
model AdConversion {
  id           String          @id @default(uuid())
  impressionId String          @map("impression_id")
  impression   AdImpression    @relation(fields: [impressionId], references: [id], onDelete: Cascade)
  adId         String          @map("ad_id")
  accountId    String          @map("account_id")
  account      AdAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  keyId        String?         @map("key_id")
  key          AdConversionKey? @relation(fields: [keyId], references: [id], onDelete: SetNull)
  eventName    String          @map("event_name")
  // De onde veio: "API" (o anunciante mandou, com a chave) ou "VOTZ_MESSAGE" (a pessoa escreveu para a página da empresa
  // depois de tocar no anúncio de mensagens; só o fato, nunca o texto).
  source       String          @default("API")
  valueCents   Int             @default(0) @map("value_cents")
  occurredAt   DateTime        @map("occurred_at")
  receivedAt   DateTime        @default(now()) @map("received_at")
  dedupeKey    String          @map("dedupe_key")

  @@unique([accountId, dedupeKey])
  @@index([impressionId])
  @@index([adId, occurredAt])
  @@map("ad_conversions")
}

// "Esconder todos desta empresa": a pessoa não vê mais anúncios dela.
model AdHiddenAdvertiser {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, companyId])
  @@map("ad_hidden_advertisers")
}

// ── Anúncios: tráfego inválido (plano de anúncios, seção 7) ─────────────────
// Uma linha por anúncio e dia em que o job de hora em hora achou sinal de tráfego inválido. Cliques além do plausível
// são creditados ao anunciante (só em anúncio cobrado por clique) e o caso vai para a fila da moderação.

enum AdFraudLevel {
  REVIEW // só vai para a revisão humana (e crédito, se cobrado por clique)
  EXTREME // além disso o anúncio é pausado
}

enum AdFraudStatus {
  OPEN
  CONFIRMED // a moderação confirmou: o tráfego era inválido
  DISMISSED // a moderação descartou: era tráfego normal (o anúncio pausado volta; o crédito fica)
}

model AdFraudFlag {
  id                  String        @id @default(uuid())
  adId                String        @map("ad_id")
  ad                  Ad            @relation(fields: [adId], references: [id], onDelete: Cascade)
  accountId           String        @map("account_id")
  day                 DateTime      @db.Date
  level               AdFraudLevel
  // Nomes dos sinais: CTR_ABNORMAL, CLICKS_WITHOUT_VIEW.
  signals             String[]
  viewable            Int
  clicks              Int
  clicksWithoutView   Int           @map("clicks_without_view")
  invalidClicks       Int           @map("invalid_clicks")
  // Já devolvido ao anunciante por este caso (milésimos de centavo). Só cresce.
  creditedMillicents  Int           @default(0) @map("credited_millicents")
  pausedAd            Boolean       @default(false) @map("paused_ad")
  status              AdFraudStatus @default(OPEN)
  resolvedById        String?       @map("resolved_by_id")
  resolvedAt          DateTime?     @map("resolved_at")
  resolutionNote      String?       @map("resolution_note")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  @@unique([adId, day])
  @@index([status, createdAt])
  @@index([accountId])
  @@map("ad_fraud_flags")
}

// ── Anúncios: página de destino (plano de anúncios, seção 5.3) ──────────────
// Cada conferência da página para onde o botão do anúncio leva: ao enviar, toda semana e na nova tentativa depois de uma falha.
// `status`: OK, BAD_STATUS (a página responde erro), UNREACHABLE (não abre) ou BLOCKED (foi para domínio proibido, rede interna ou http).

model AdLandingCheck {
  id         String   @id @default(uuid())
  adId       String   @map("ad_id")
  ad         Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  // SUBMIT, WEEKLY ou RETRY.
  trigger    String
  status     String
  httpStatus Int?     @map("http_status")
  // Site em que o link terminou depois dos redirecionamentos (só o domínio).
  finalHost  String?  @map("final_host")
  redirects  Int      @default(0)
  // REDIRECT_OFF_SITE, TOO_MANY_REDIRECTS, REDIRECT_TO_HTTP, BLOCKED_DOMAIN, PRIVATE_ADDRESS.
  problems   String[]
  checkedAt  DateTime @default(now()) @map("checked_at")

  @@index([adId, checkedAt])
  @@map("ad_landing_checks")
}

// ── Contexto da Comunidade (docs/dev/contexto-da-comunidade-analise-2026-11-23.md) ──────────────
// Notas escritas por pessoas habilitadas, com fonte, sobre uma publicação do feed ou um relato.
// A nota ACRESCENTA informação: tirar conteúdo do ar continua só com a moderação.
// Relato anônimo tem `authorId` nulo, então o autor dele não pode ser excluído da avaliação (limite conhecido).

enum ContextNoteKind {
  // Publicação: correção com fonte, contexto que falta, foto ou vídeo fora de contexto.
  CORRECTION
  MISSING_CONTEXT
  OUT_OF_CONTEXT_MEDIA
  // Relato (tipos fechados, nunca "é falso"): prova adicional, atualização, duplicado.
  EXTRA_EVIDENCE
  UPDATE
  DUPLICATE
}

enum ContextNoteStatus {
  NEEDS_RATINGS
  SHOWN
  NOT_SHOWN
  REMOVED
}

enum ContextNoteOrigin {
  HUMAN
  AI
}

enum ContextNoteRatingValue {
  HELPFUL
  SOMEWHAT
  NOT_HELPFUL
}

model ContextNote {
  id             String            @id @default(uuid())
  // Exatamente um dos dois (checado por constraint no banco).
  postId         String?           @map("post_id")
  post           Post?             @relation(fields: [postId], references: [id], onDelete: Cascade)
  reportId       String?           @map("report_id")
  report         Report?           @relation(fields: [reportId], references: [id], onDelete: Cascade)
  // Nulo quando a conta de quem escreveu é excluída (a nota fica, sem autor) e quando a origem é IA.
  authorId       String?           @map("author_id")
  author         User?             @relation("ContextNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  origin         ContextNoteOrigin @default(HUMAN)
  kind           ContextNoteKind
  text           String            @db.VarChar(500)
  // Pelo menos um link (validado no serviço).
  sources        String[]
  status         ContextNoteStatus @default(NEEDS_RATINGS)
  // Números calculados pelo job de hora em hora; a verdade continua na tabela de avaliações.
  ratingsCount   Int               @default(0) @map("ratings_count")
  helpfulShare   Float?            @map("helpful_share")
  // Quantas rodadas seguidas a nota exibida ficou abaixo da régua (só sai do ar na segunda).
  badStreak      Int               @default(0) @map("bad_streak")
  shownAt        DateTime?         @map("shown_at")
  removedAt      DateTime?         @map("removed_at")
  removedReason  String?           @map("removed_reason") @db.VarChar(500)
  removedById    String?           @map("removed_by_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  ratings        ContextNoteRating[]
  statusLog      ContextNoteStatusLog[]

  @@index([postId, status])
  @@index([reportId, status])
  @@index([status, createdAt])
  @@index([authorId, createdAt])
  @@map("context_notes")
}

model ContextNoteRating {
  id        String                 @id @default(uuid())
  noteId    String                 @map("note_id")
  note      ContextNote            @relation(fields: [noteId], references: [id], onDelete: Cascade)
  // Apagada junto com a conta (direito de eliminação).
  raterId   String                 @map("rater_id")
  rater     User                   @relation("ContextNoteRater", fields: [raterId], references: [id], onDelete: Cascade)
  value     ContextNoteRatingValue
  // Motivos de uma lista fechada (ver `CONTEXT_NOTE_RATING_REASONS` em @votz/shared-types).
  reasons   String[]
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  @@unique([noteId, raterId])
  @@index([raterId, createdAt])
  @@map("context_note_ratings")
}

// "Pedir contexto": uma pessoa diz que gostaria de ver contexto neste conteúdo. Não vira nota sozinho.
model ContextNoteRequest {
  id          String   @id @default(uuid())
  postId      String?  @map("post_id")
  post        Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  reportId    String?  @map("report_id")
  report      Report?  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  requesterId String   @map("requester_id")
  requester   User     @relation("ContextNoteRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([requesterId, postId])
  @@unique([requesterId, reportId])
  @@index([postId])
  @@index([reportId])
  @@map("context_note_requests")
}

// Quem pode escrever e avaliar. Entra com aceite do termo do colaborador (maior de 18, regras de escrita).
model ContextContributor {
  userId           String    @id @map("user_id")
  user             User      @relation("ContextContributorUser", fields: [userId], references: [id], onDelete: Cascade)
  termsVersion     String    @map("terms_version")
  termsAcceptedAt  DateTime  @map("terms_accepted_at")
  // Quantas avaliações a pessoa deu e quantas coincidiram com o resultado final (nota exibida ou não).
  ratingsGiven     Int       @default(0) @map("ratings_given")
  ratingsResolved  Int       @default(0) @map("ratings_resolved")
  ratingsAligned   Int       @default(0) @map("ratings_aligned")
  // A moderação pode convidar para escrever antes de a pessoa cumprir a régua.
  writeGrantedAt   DateTime? @map("write_granted_at")
  suspendedAt      DateTime? @map("suspended_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("context_contributors")
}

// Histórico imutável das mudanças de status de cada nota (alimenta a Memória). Nunca é editado nem apagado pelo código.
model ContextNoteStatusLog {
  id           String             @id @default(uuid())
  noteId       String             @map("note_id")
  note         ContextNote        @relation(fields: [noteId], references: [id], onDelete: Cascade)
  fromStatus   ContextNoteStatus? @map("from_status")
  toStatus     ContextNoteStatus  @map("to_status")
  // RULE (job), MODERATION ou CREATED.
  cause        String
  actorId      String?            @map("actor_id")
  ratingsCount Int                @default(0) @map("ratings_count")
  helpfulShare Float?             @map("helpful_share")
  createdAt    DateTime           @default(now()) @map("created_at")

  @@index([noteId, createdAt])
  @@map("context_note_status_log")
}

// ==================== PESQUISA VOTZ (OFICIAL ANONIMIZADA) ====================

enum SurveyKind {
  VOTING_INTENTION  // Intenção de voto (estimulada, 1º/2º turno, rejeição)
  APPROVAL_RATING   // Avaliação de gestão (Executivo / Legislativo)
  CIVIC_TOPIC       // Pesquisa cívica / temática / consulta pública
}

enum SurveyOrigin {
  VOTZ              // Iniciativa oficial da equipe Votz
  PARTNER_INSTITUTE // Instituto de pesquisa / universidade parceira credenciada
  PUBLIC_ENTITY     // Consulta pública de entidade pública (prefeitura, secretaria, câmara)
}

enum SurveyDistributionMode {
  OPEN           // Aberta na vitrine /pesquisas a todos os cidadãos elegíveis
  INVITED_SAMPLE // Amostra sorteada com quarentena de tema/cargo entre institutos (Fase 2)
}

enum SurveyMethodologyType {
  OPEN_PANEL       // Sondagem aberta entre usuários do Votz (amostra não probabilística)
  WEIGHTED_QUOTA   // Amostra estratificada / ponderada por cotas (IBGE)
  REGISTERED_TSE   // Pesquisa eleitoral registrada no PesqEle (TSE)
}

enum SurveyStatus {
  DRAFT       // Em preparação pelo Admin
  SCHEDULED   // Publicação agendada
  OPEN        // Coleta aberta
  CLOSED      // Coleta encerrada (resultados congelados e salt destruído)
  ARCHIVED    // Arquivada (histórico público preservado)
  CANCELLED   // Cancelada (trava eleitoral ou irregularidade)
}

enum SurveyScope {
  NATIONAL
  STATE
  MUNICIPAL
}

enum SurveyVerificationLevel {
  STANDARD      // E-mail verificado + idade mínima da conta
  VERIFIED_CPF  // Exige CPF cadastrado (dedup por CPF normalizado)
}

enum SurveyQuestionType {
  SINGLE_CHOICE    // Escolha única (ex.: 1º turno, avaliação)
  MULTIPLE_CHOICE  // Múltipla escolha limitada (ex.: rejeição, até maxSelections)
  SCALE_5          // Escala 1..5 (ex.: Ótimo a Péssimo)
}

enum SurveyResultsVisibility {
  AFTER_VOTE   // Cidadão vê parciais após votar (e público após atingir quórum mínimo)
  AFTER_CLOSE  // Resultados só aparecem quando a pesquisa encerrar (evita efeito manada)
}

enum SurveyReviewStatus {
  APPROVED          // Aprovada pelo Admin do Votz (padrão para pesquisas criadas pelo Admin)
  PENDING_REVIEW    // Submetida por Entidade / Parceiro aguardando revisão editorial
  CHANGES_REQUESTED // Admin solicitou ajustes antes de aprovar
  REJECTED          // Recusada (ex.: pergunta tendenciosa ou fora do escopo)
}

enum SurveyInvitationStatus {
  INVITED   // Sorteado e convidado para responder
  RESPONDED // Participou (sem vínculo com a cédula anônima)
  DECLINED  // Recusou o convite
  EXPIRED   // Janela encerrada sem resposta
}

/// Instituto de pesquisa ou universidade credenciada no Votz (página pública + ficha técnica).
model ResearchInstitute {
  id               String           @id @default(uuid())
  slug             String           @unique
  name             String           @db.VarChar(160)
  legalName        String           @map("legal_name") @db.VarChar(200)
  cnpj             String?          @unique @db.VarChar(18)
  logoUrl          String?          @map("logo_url") @db.VarChar(500)
  website          String?          @db.VarChar(300)
  description      String?          @db.Text
  statisticianLead String?          @map("statistician_lead") @db.VarChar(140)
  conreLead        String?          @map("conre_lead") @db.VarChar(40)
  verified         Boolean          @default(false)
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  surveys          OfficialSurvey[]

  @@map("research_institutes")
}

model OfficialSurvey {
  id                  String                  @id @default(uuid())
  slug                String                  @unique
  title               String                  @db.VarChar(180)
  subtitle            String?                 @db.VarChar(320)
  description         String                  @db.Text
  kind                SurveyKind
  origin              SurveyOrigin            @default(VOTZ)
  distributionMode    SurveyDistributionMode  @default(OPEN) @map("distribution_mode")
  methodologyType     SurveyMethodologyType   @default(OPEN_PANEL) @map("methodology_type")
  status              SurveyStatus            @default(DRAFT)
  reviewStatus        SurveyReviewStatus      @default(APPROVED) @map("review_status")
  reviewNote          String?                 @map("review_note") @db.Text
  submittedByUserId   String?                 @map("submitted_by_user_id")
  scope               SurveyScope             @default(NATIONAL)
  targetState         String?                 @map("target_state") @db.VarChar(2)
  targetCity          String?                 @map("target_city") @db.VarChar(120)
  targetIbgeCode      String?                 @map("target_ibge_code") @db.VarChar(10)

  // Chave de tema/cargo para quarentena de 30 dias entre institutos e comparador histórico
  // Ex.: "ELECTION:PREFEITO:SP:SAO_PAULO" ou "ELECTION:PRESIDENTE:BR"
  topicKey            String?                 @map("topic_key") @db.VarChar(120)
  cooldownDays        Int                     @default(30) @map("cooldown_days")
  targetSampleSize    Int?                    @map("target_sample_size")

  // Parceiro / Instituto / Entidade / Contratante (ficha técnica padronizada)
  instituteId         String?                 @map("institute_id")
  institute           ResearchInstitute?      @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  sponsorEntityId     String?                 @map("sponsor_entity_id")
  partnerName         String?                 @map("partner_name") @db.VarChar(160)
  partnerLogoUrl      String?                 @map("partner_logo_url") @db.VarChar(500)
  contractorName      String?                 @map("contractor_name") @db.VarChar(160)
  marginOfError       Float?                  @map("margin_of_error")
  confidenceLevel     Int?                    @map("confidence_level")

  // Elegibilidade, quórum e anonimato
  verificationLevel   SurveyVerificationLevel @default(STANDARD) @map("verification_level")
  minAccountAgeDays   Int                     @default(7) @map("min_account_age_days")
  resultsVisibility   SurveyResultsVisibility @default(AFTER_CLOSE) @map("results_visibility")
  minQuorumToPublish  Int                     @default(100) @map("min_quorum_to_publish")
  kAnonymityThreshold Int                     @default(30) @map("k_anonymity_threshold")
  featuredInFeed      Boolean                 @default(false) @map("featured_in_feed")

  // Janela de coleta
  startsAt            DateTime?               @map("starts_at")
  endsAt              DateTime?               @map("ends_at")
  closedAt            DateTime?               @map("closed_at")

  // Segredo exclusivo desta pesquisa cifrado via CryptoService (AES-256-GCM).
  // Destruído (setado para null) no encerramento após esvaziar o Mix Pool (crypto-shredding).
  nullifierSaltEnc    String?                 @map("nullifier_salt_enc")
  saltDestroyedAt     DateTime?               @map("salt_destroyed_at")

  // Conformidade TSE / Transparência metodológica
  isElectoral         Boolean                 @default(false) @map("is_electoral")
  tseRegistrationCode String?                 @map("tse_registration_code") @db.VarChar(60)
  statisticianName    String?                 @map("statistician_name") @db.VarChar(140)
  statisticianConre   String?                 @map("statistician_conre") @db.VarChar(40)
  methodologyNote     String                  @map("methodology_note") @db.Text
  disclaimerText      String                  @map("disclaimer_text") @db.Text

  // Auditoria administrativa (quem criou/publicou/cancelou — nunca quem votou)
  createdById         String                  @map("created_by_id")
  publishedById       String?                 @map("published_by_id")
  cancelReason        String?                 @map("cancel_reason") @db.Text
  totalBallots        Int                     @default(0) @map("total_ballots")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  questions           OfficialSurveyQuestion[]
  participations      OfficialSurveyParticipation[]
  pendingBallots      OfficialSurveyPendingBallot[]
  ballots             OfficialSurveyBallot[]
  aggregates          OfficialSurveyAggregate[]
  invitations         OfficialSurveyInvitation[]

  @@index([status, featuredInFeed, startsAt])
  @@index([scope, targetState, targetIbgeCode, status])
  @@index([topicKey, status])
  @@index([sponsorEntityId, status])
  @@index([reviewStatus, status])
  @@map("official_surveys")
}

/// Convite de amostra sorteada (Fase 2 — INVITED_SAMPLE) com quarentena por `topicKey`.
/// NUNCA aponta para cédula nem resposta; serve apenas para controle de convite e quarentena.
model OfficialSurveyInvitation {
  id              String                 @id @default(uuid())
  surveyId        String                 @map("survey_id")
  survey          OfficialSurvey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId          String                 @map("user_id")
  topicKey        String?                @map("topic_key") @db.VarChar(120)
  status          SurveyInvitationStatus @default(INVITED)
  invitedAt       DateTime               @default(now()) @map("invited_at")
  expiresAt       DateTime?              @map("expires_at")
  respondedBucket DateTime?              @map("responded_bucket")

  @@unique([surveyId, userId])
  @@index([userId, status])
  @@index([userId, topicKey, invitedAt])
  @@map("official_survey_invitations")
}

model OfficialSurveyQuestion {
  id                  String                 @id @default(uuid())
  surveyId            String                 @map("survey_id")
  survey              OfficialSurvey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  position            Int
  prompt              String                 @db.VarChar(300)
  helpText            String?                @db.VarChar(300) @map("help_text")
  type                SurveyQuestionType     @default(SINGLE_CHOICE)
  required            Boolean                @default(true)
  maxSelections       Int                    @default(1) @map("max_selections")
  randomizeOptions    Boolean                @default(true) @map("randomize_options")
  options             OfficialSurveyOption[]

  @@unique([surveyId, position])
  @@map("official_survey_questions")
}

model OfficialSurveyOption {
  id                  String                 @id @default(uuid())
  questionId          String                 @map("question_id")
  question            OfficialSurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position            Int
  label               String                 @db.VarChar(160)
  subtitle            String?                @db.VarChar(160)
  imageUrl            String?                @map("image_url") @db.VarChar(500)
  politicianId        String?                @map("politician_id")
  isPinnedBottom      Boolean                @default(false) @map("is_pinned_bottom")

  @@unique([questionId, position])
  @@map("official_survey_options")
}

/// TABELA A: Controle estrito de 1 voto por pessoa.
/// ZERO resposta, ZERO apontamento para cédula, ZERO IP.
model OfficialSurveyParticipation {
  id                  String         @id @default(uuid())
  surveyId            String         @map("survey_id")
  survey              OfficialSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  nullifierHash       String         @map("nullifier_hash") @db.VarChar(64)
  participatedBucket  DateTime       @map("participated_bucket")

  @@unique([surveyId, nullifierHash])
  @@index([surveyId])
  @@map("official_survey_participations")
}

/// FILA TRANSITÓRIA (Mix Pool persistente em banco): guarda cédulas cifradas sem qualquer
/// ligação com User/CPF/nullifier até o worker BullMQ drenar e embaralhar em lote (Fisher-Yates).
model OfficialSurveyPendingBallot {
  id                  String         @id @default(uuid())
  surveyId            String         @map("survey_id")
  survey              OfficialSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  payloadEnc          String         @map("payload_enc") @db.Text
  queuedBucket        DateTime       @map("queued_bucket")

  @@index([surveyId])
  @@map("official_survey_pending_ballots")
}

/// TABELA B: Cédula 100% anônima, gravada fora de ordem via lote embaralhado.
/// ZERO referência a User, CPF, nullifierHash, IP ou deviceId.
model OfficialSurveyBallot {
  id                  String         @id @default(uuid())
  surveyId            String         @map("survey_id")
  survey              OfficialSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answersJson         Json           @map("answers_json")
  ageBand             String?        @map("age_band") @db.VarChar(16)
  gender              String?        @db.VarChar(24)
  state               String?        @db.VarChar(2)
  ibgeCode            String?        @map("ibge_code") @db.VarChar(10)
  submittedBucket     DateTime       @map("submitted_bucket")

  @@index([surveyId, submittedBucket])
  @@index([surveyId, state])
  @@map("official_survey_ballots")
}

/// Agregados pré-calculados por segmento para leitura rápida e proteção garantida por k-anonimato.
model OfficialSurveyAggregate {
  id                  String         @id @default(uuid())
  surveyId            String         @map("survey_id")
  survey              OfficialSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  questionId          String         @map("question_id")
  optionId            String         @map("option_id")
  segmentKey          String         @map("segment_key") @db.VarChar(64)
  votesCount          Int            @default(0) @map("votes_count")
  segmentTotal        Int            @default(0) @map("segment_total")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@unique([surveyId, questionId, optionId, segmentKey])
  @@index([surveyId, segmentKey])
  @@map("official_survey_aggregates")
}

// ==================== CONFIGURAÇÕES DE CONTA E NOTIFICAÇÕES ====================

model UserNotificationPreference {
  userId                  String   @id @map("user_id")
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Canais
  inAppEnabled            Boolean  @default(true) @map("in_app_enabled")
  emailEnabled            Boolean  @default(true) @map("email_enabled")
  pushEnabled             Boolean  @default(true) @map("push_enabled")

  // Eventos
  reportUpdates           Boolean  @default(true) @map("report_updates")
  reportComments          Boolean  @default(true) @map("report_comments")
  officialResponses       Boolean  @default(true) @map("official_responses")
  localSurges             Boolean  @default(true) @map("local_surges")
  officialSurveys         Boolean  @default(true) @map("official_surveys")
  mentions                Boolean  @default(true)
  weeklyDigest            Boolean  @default(false) @map("weekly_digest")

  // Horário de silêncio ("Não perturbe", 0..23 em horário de Brasília; null = desligado)
  quietHoursStart         Int?     @map("quiet_hours_start")
  quietHoursEnd           Int?     @map("quiet_hours_end")

  // Privacidade cívica do cidadão
  defaultAnonymousReports Boolean  @default(false) @map("default_anonymous_reports")
  publicActivityVisible   Boolean  @default(true) @map("public_activity_visible")
  acceptPressContact      Boolean  @default(false) @map("accept_press_contact")

  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("user_notification_preferences")
}
