model Post {
  id                   String      @id @default(uuid())
  content              String      @db.VarChar(2000)
  kind                 PostKind    @default(STANDARD)
  media                String[]
  mediaKeys            String[]    @map("media_keys")

  authorUserId         String      @map("author_user_id")
  authorUser           User        @relation("PostAuthorUser", fields: [authorUserId], references: [id])
  authorOrgType        OrgType?    @map("author_org_type")
  authorOrgId          String?     @map("author_org_id")

  city                 String?
  cityKey              String?     @map("city_key")
  state                String?

  mentionedReportId    String?     @map("mentioned_report_id")
  mentionedReport      Report?     @relation(fields: [mentionedReportId], references: [id], onDelete: SetNull)
  mentionedDebateId    String?     @map("mentioned_debate_id")
  mentionedDebate      Debate?     @relation(fields: [mentionedDebateId], references: [id], onDelete: SetNull)
  mentionedPropostaId  String?     @map("mentioned_proposta_id")
  mentionedProposta    Proposta?   @relation(fields: [mentionedPropostaId], references: [id], onDelete: SetNull)
  mentionedDebatePollId String?    @map("mentioned_debate_poll_id")
  mentionedDebatePoll  DebatePoll? @relation(fields: [mentionedDebatePollId], references: [id], onDelete: SetNull)
  quotePostId          String?     @map("quote_post_id")
  quotePost            Post?       @relation("PostQuotes", fields: [quotePostId], references: [id], onDelete: SetNull)
  quotedBy             Post[]      @relation("PostQuotes")

  likesCount           Int         @default(0) @map("likes_count")
  commentsCount        Int         @default(0) @map("comments_count")
  repostsCount         Int         @default(0) @map("reposts_count")
  engagementScore      Float       @default(0) @map("engagement_score")
  hotScore             Float       @default(0) @map("hot_score")
  lastEngagedAt        DateTime    @default(now()) @map("last_engaged_at")

  poll                 PostPoll?
  likes                PostLike[]
  reposts              PostRepost[]
  comments             PostComment[]
  topics               PostTopic[]
  // Fotos e vídeos no padrão de formatos (docs/dev/padrao-de-midia-plano-2026-11-21.md), na ordem de `position`.
  mediaAssets MediaAsset[]
  contextNotes         ContextNote[]
  contextRequests      ContextNoteRequest[]

  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  @@index([hotScore(sort: Desc), createdAt(sort: Desc)])
  @@index([state, cityKey, hotScore(sort: Desc)])
  @@index([authorUserId, createdAt(sort: Desc)])
  @@index([authorOrgType, authorOrgId, createdAt(sort: Desc)])
  @@index([mentionedReportId])
  @@map("posts")
}

